}

# initコマンド
init_vibebox() {
    echo "=== vibebox を初期化 ==="
    echo

    # 現在のディレクトリを取得
    local target_dir="$(pwd)"
    local target_vibebox_dir="$target_dir/.vibebox"

    # スクリプトのディレクトリからテンプレートファイルの場所を特定
    local script_path
    script_path="$(resolve_absolute_path "${BASH_SOURCE[0]}")"
    local script_dir="$(dirname "$script_path")"
    local template_dir="$script_dir/.vibebox"

    # テンプレートディレクトリの存在確認
    if [[ ! -d "$template_dir" ]]; then
        echo "エラー: テンプレートディレクトリが見つかりません: $template_dir" >&2
        exit 1
    fi

    # 必要なテンプレートファイルの存在確認
    if [[ ! -f "$template_dir/claude-pty" ]]; then
        echo "エラー: claude-ptyテンプレートが見つかりません: $template_dir/claude-pty" >&2
        exit 1
    fi

    if [[ ! -f "$template_dir/Dockerfile.template" ]]; then
        echo "エラー: Dockerfile.templateが見つかりません: $template_dir/Dockerfile.template" >&2
        exit 1
    fi

    if [[ ! -f "$template_dir/.devcontainer/hooks-initialize.sh" ]]; then
        echo "エラー: hooks-initialize.shテンプレートが見つかりません: $template_dir/.devcontainer/hooks-initialize.sh" >&2
        exit 1
    fi

    # .vibeboxディレクトリが既に存在するかチェック
    if [[ -d "$target_vibebox_dir" ]]; then
        echo "警告: .vibeboxディレクトリが既に存在します: $target_vibebox_dir"
        read -p "既存のディレクトリを上書きしますか？ (y/N): " -r
        if [[ ! $REPLY =~ ^[Yy]$ ]]; then
            echo "初期化を中止しました。"
            exit 0
        fi
    fi

    # .vibeboxディレクトリを作成
    echo "ディレクトリを作成: $target_vibebox_dir"
    mkdir -p "$target_vibebox_dir"

    # claude-ptyをコピー
    echo "ファイルをコピー: claude-pty"
    cp "$template_dir/claude-pty" "$target_vibebox_dir/claude-pty"
    chmod +x "$target_vibebox_dir/claude-pty"

    # BASE_IMAGEの入力を求める
    echo
    echo "ベースイメージを指定してください。"
    echo "例:"
    echo "  - ubuntu:22.04"
    echo "  - python:3.11-slim"
    echo "  - node:20-alpine"
    echo
    read -p "BASE_IMAGE [ubuntu:22.04]: " base_image

    # デフォルト値の設定
    if [[ -z "$base_image" ]]; then
        base_image="ubuntu:22.04"
    fi

    echo
    echo "ベースイメージ: $base_image"

    # カレントディレクトリ名を取得
    local repo_name="$(basename "$target_dir")"

    local container_username
    read -p "コンテナ内ユーザー名 [${DEFAULT_CONTAINER_USERNAME}]: " container_username
    if [[ -z "$container_username" ]]; then
        container_username="$DEFAULT_CONTAINER_USERNAME"
    fi

    local default_devcontainer_image="${VIBEBOX_DEVCONTAINER_IMAGE:-vibebox/${repo_name}:latest}"
    local devcontainer_image
    read -p "devcontainer image [$default_devcontainer_image]: " devcontainer_image
    if [[ -z "$devcontainer_image" ]]; then
        devcontainer_image="$default_devcontainer_image"
    fi

    local default_envchain_service="${VIBEBOX_ENVCHAIN_SERVICE:-vibebox:${repo_name}:ecr}"
    local envchain_service
    read -p "envchain service [$default_envchain_service]: " envchain_service
    if [[ -z "$envchain_service" ]]; then
        envchain_service="$default_envchain_service"
    fi

    # Dockerfile.templateをコピーしてプレースホルダを置換
    echo "ファイルを作成: Dockerfile"
    local escaped_base_image
    local escaped_container_username
    escaped_base_image=$(escape_sed_replacement "$base_image")
    escaped_container_username=$(escape_sed_replacement "$container_username")
    sed \
        -e "s|{BASE_IMAGE}|$escaped_base_image|g" \
        -e "s|{USERNAME}|$escaped_container_username|g" \
        "$template_dir/Dockerfile.template" > "$target_vibebox_dir/Dockerfile"

    # .devcontainerディレクトリを作成
    mkdir -p "$target_dir/.devcontainer"

    # .devcontainerファイルのコピー
    if [[ -f "$template_dir/.devcontainer/devcontainer.json" ]]; then
        echo "ファイルを作成: .devcontainer/devcontainer.json"
        local escaped_repo_name
        local escaped_devcontainer_image
        local escaped_envchain_service
        escaped_repo_name=$(escape_sed_replacement "$repo_name")
        escaped_devcontainer_image=$(escape_sed_replacement "$devcontainer_image")
        escaped_envchain_service=$(escape_sed_replacement "$envchain_service")
        sed \
            -e "s|{REPO_NAME}|$escaped_repo_name|g" \
            -e "s|{USERNAME}|$escaped_container_username|g" \
            -e "s|{DEVCONTAINER_IMAGE}|$escaped_devcontainer_image|g" \
            -e "s|{ENVCHAIN_SERVICE}|$escaped_envchain_service|g" \
            "$template_dir/.devcontainer/devcontainer.json" > "$target_dir/.devcontainer/devcontainer.json"
    fi

    if [[ -f "$template_dir/.devcontainer/hooks-post-start.sh" ]]; then
        echo "ファイルをコピー: .devcontainer/hooks-post-start.sh"
        cp "$template_dir/.devcontainer/hooks-post-start.sh" "$target_dir/.devcontainer/hooks-post-start.sh"
        chmod +x "$target_dir/.devcontainer/hooks-post-start.sh"
    fi

    if [[ -f "$template_dir/.devcontainer/hooks-initialize.sh" ]]; then
        echo "ファイルをコピー: .devcontainer/hooks-initialize.sh"
        cp "$template_dir/.devcontainer/hooks-initialize.sh" "$target_dir/.devcontainer/hooks-initialize.sh"
        chmod +x "$target_dir/.devcontainer/hooks-initialize.sh"
    fi

    if [[ -f "$template_dir/.devcontainer/ecr-login.sh" ]]; then
        echo "ファイルをコピー: .devcontainer/ecr-login.sh"
        cp "$template_dir/.devcontainer/ecr-login.sh" "$target_dir/.devcontainer/ecr-login.sh"
        chmod +x "$target_dir/.devcontainer/ecr-login.sh"
    fi

    echo
    echo "=== 初期化完了 ==="
    echo ".vibeboxディレクトリが作成されました: $target_vibebox_dir"
    echo
    echo "次のステップ:"
    echo "1. 必要に応じて $target_vibebox_dir/Dockerfile を編集してください"
    echo "2. 'vibebox container build' でDockerイメージをビルドしてください"
    echo "3. 'vibebox up [branch-name]' でセッションを開始してください"
}

clean_jsonc_file() {
    sed 's://.*$::g; s:/\*.*\*/::g' "$1"
}

supports_color_output() {
    [[ -t 1 && -z "${NO_COLOR:-}" && "${TERM:-}" != "dumb" ]]
}

colorize_unified_diff() {
    awk '
        BEGIN {
            red = sprintf("%c[31m", 27)
            green = sprintf("%c[32m", 27)
            cyan = sprintf("%c[36m", 27)
            bold = sprintf("%c[1m", 27)
            reset = sprintf("%c[0m", 27)
        }
        /^--- / {
            print bold red $0 reset
            next
        }
        /^\+\+\+ / {
            print bold green $0 reset
            next
        }
        /^@@ / {
            print cyan $0 reset
            next
        }
        /^\+/ {
            print green $0 reset
            next
        }
        /^-/ {
            print red $0 reset
            next
        }
        {
            print
        }
    '
}

show_unified_diff() {
    local source_file="$1"
    local updated_file="$2"

    if supports_color_output; then
        diff -u "$source_file" "$updated_file" | colorize_unified_diff
    else
        diff -u "$source_file" "$updated_file"
    fi
}

backup_file_for_update() {
    local file_path="$1"
    local timestamp="$2"

    cp "$file_path" "${file_path}.bak.${timestamp}"
    echo "バックアップを作成: ${file_path}.bak.${timestamp}"
}

is_git_tracked_file() {
    local file_path="$1"
    local file_dir
    file_dir="$(dirname "$file_path")"

    if ! git -C "$file_dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        return 1
    fi

    local git_root
    git_root="$(git -C "$file_dir" rev-parse --show-toplevel 2>/dev/null)" || return 1

    local relative_path="${file_path#$git_root/}"
    if [[ "$relative_path" == "$file_path" ]]; then
        return 1
    fi

    git -C "$git_root" ls-files --error-unmatch -- "$relative_path" >/dev/null 2>&1
}

write_updated_file() {
    local source_file="$1"
    local updated_file="$2"
    local dry_run="$3"
    local timestamp="$4"
    local target_file="${5:-$source_file}"

    if cmp -s "$source_file" "$updated_file"; then
        echo "変更なし: $target_file"
        return 1
    fi

    if [[ "$dry_run" == "true" ]]; then
        echo "変更予定: $target_file"
        show_unified_diff "$source_file" "$updated_file" || true
        return 0
    fi

    if [[ -f "$target_file" ]]; then
        if is_git_tracked_file "$target_file"; then
            echo "Git管理下のためバックアップを省略: $target_file"
        else
            backup_file_for_update "$target_file" "$timestamp"
        fi
    else
        mkdir -p "$(dirname "$target_file")"
    fi
    cp "$updated_file" "$target_file"
    echo "更新しました: $target_file"
    return 0
}

generate_updated_dockerfile() {
    local source_file="$1"
    local updated_file="$2"

    cp "$source_file" "$updated_file"

    if ! grep -q 'openssh-server' "$updated_file"; then
        cat >> "$updated_file" <<'EOF'

# vibebox-update: install SSH server for OrbStack container domains.
USER root
RUN apt update && apt install -y openssh-server
EOF
    fi

    if ! grep -q 'sshd_config.d/vibebox.conf' "$updated_file"; then
        cat >> "$updated_file" <<'EOF'

# vibebox-update: configure SSH access for OrbStack container domains.
USER root
RUN mkdir -p /run/sshd /home/$USERNAME/.ssh \
  && chmod 700 /home/$USERNAME/.ssh \
  && chown -R $USERNAME:$USERNAME /home/$USERNAME/.ssh \
  && printf '%s\n' \
    'PasswordAuthentication no' \
    'KbdInteractiveAuthentication no' \
    'ChallengeResponseAuthentication no' \
    'PubkeyAuthentication yes' \
    'PermitRootLogin no' \
    "AllowUsers $USERNAME" \
    > /etc/ssh/sshd_config.d/vibebox.conf
USER $USERNAME
EOF
    fi
}

generate_updated_devcontainer_json() {
    local source_file="$1"
    local updated_file="$2"
    local remote_user="$3"
    local repo_name="$4"
    local cleaned_file
    cleaned_file=$(mktemp)

    clean_jsonc_file "$source_file" > "$cleaned_file"

    local authorized_keys_mount="source=\${localWorkspaceFolder}/.devcontainer/.vibebox-authorized_keys,target=/home/${remote_user}/.ssh/authorized_keys,type=bind,readonly"
    local ssh_init_command="bash .devcontainer/hooks-initialize.sh ${remote_user} vibebox.${repo_name}"

    jq --arg mount "$authorized_keys_mount" --arg ssh_init "$ssh_init_command" '
        def strip_legacy_authorized_keys_command:
            if contains(".vibebox-authorized_keys") and (contains("hooks-initialize.sh") | not) then
                sub("^mkdir -p \\.devcontainer && if ls .*?; fi && "; "")
            else
                .
            end;

        .mounts = ((.mounts // []) as $mounts |
            if ($mounts | map(tostring | contains(".vibebox-authorized_keys")) | any) then
                $mounts
            else
                $mounts + [$mount]
            end
        )
        |
        if ((.initializeCommand // "" | tostring) | contains("hooks-initialize.sh")) then
            .
        elif ((.initializeCommand // null) | type) == "array"
             and (.initializeCommand | length) >= 3
             and .initializeCommand[0] == "bash"
             and .initializeCommand[1] == "-c" then
            .initializeCommand[2] = ($ssh_init + " && " + (.initializeCommand[2] | strip_legacy_authorized_keys_command))
        elif ((.initializeCommand // null) | type) == "string" then
            .initializeCommand = ($ssh_init + " && " + (.initializeCommand | strip_legacy_authorized_keys_command))
        elif .initializeCommand == null then
            .initializeCommand = ["bash", "-c", $ssh_init]
        elif ((.initializeCommand // null) | type) == "array" then
            .initializeCommand = ["bash", "-c", $ssh_init + " && " + (.initializeCommand | join(" "))]
        else
            .initializeCommand = ["bash", "-c", $ssh_init + " && " + (.initializeCommand | tostring)]
        end
    ' "$cleaned_file" > "$updated_file"

    rm -f "$cleaned_file"
}

generate_updated_hooks_initialize() {
    local updated_file="$1"
    local script_path
    script_path="$(resolve_absolute_path "${BASH_SOURCE[0]}")"
    local script_dir
    script_dir="$(dirname "$script_path")"
    local template_file="$script_dir/.vibebox/.devcontainer/hooks-initialize.sh"

    if [[ ! -f "$template_file" ]]; then
        echo "エラー: hooks-initialize.shテンプレートが見つかりません: $template_file" >&2
        exit 1
    fi

    cp "$template_file" "$updated_file"
}

generate_updated_hooks_post_start() {
    local source_file="$1"
    local updated_file="$2"

    if grep -q 'vibebox-update: start SSH server' "$source_file" || grep -q 'sudo /usr/sbin/sshd' "$source_file"; then
        cp "$source_file" "$updated_file"
        return 0
    fi

    awk '
        BEGIN {
            in_clone_func = 0
            inserted = 0
        }
        /^clone_or_update_repo\(\)/ {
            in_clone_func = 1
        }
        {
            print
        }
        in_clone_func && !inserted && /^}$/ {
            print ""
            print "# vibebox-update: start SSH server for OrbStack container domains."
            print "echo \"Starting SSH server...\""
            print "sudo ssh-keygen -A"
            print "sudo mkdir -p /run/sshd \"$USER_HOME/.ssh\""
            print "sudo chmod 700 \"$USER_HOME/.ssh\""
            print "sudo chown \"$CURRENT_USER:$CURRENT_USER\" \"$USER_HOME/.ssh\""
            print "sudo chmod 600 \"$USER_HOME/.ssh/authorized_keys\" 2>/dev/null || true"
            print "if ! pgrep -x sshd >/dev/null 2>&1; then"
            print "    sudo /usr/sbin/sshd"
            print "fi"
            inserted = 1
            in_clone_func = 0
        }
        END {
            if (!inserted) {
                print ""
                print "# vibebox-update: start SSH server for OrbStack container domains."
                print "echo \"Starting SSH server...\""
                print "sudo ssh-keygen -A"
                print "sudo mkdir -p /run/sshd \"$USER_HOME/.ssh\""
                print "sudo chmod 700 \"$USER_HOME/.ssh\""
                print "sudo chown \"$CURRENT_USER:$CURRENT_USER\" \"$USER_HOME/.ssh\""
                print "sudo chmod 600 \"$USER_HOME/.ssh/authorized_keys\" 2>/dev/null || true"
                print "if ! pgrep -x sshd >/dev/null 2>&1; then"
                print "    sudo /usr/sbin/sshd"
                print "fi"
            }
        }
    ' "$source_file" > "$updated_file"
}

generate_updated_gitignore() {
    local source_file="$1"
    local updated_file="$2"

    cp "$source_file" "$updated_file"
    if ! grep -Fxq '.devcontainer/.vibebox-authorized_keys' "$updated_file"; then
        printf '\n.devcontainer/.vibebox-authorized_keys\n' >> "$updated_file"
    fi
}

update_vibebox() {
    local dry_run="$1"
    local assume_yes="$2"

    echo "=== vibebox 設定を更新 ==="
    echo

    local target_dir
    target_dir="$(pwd)"
    local dockerfile_path="$target_dir/.vibebox/Dockerfile"
    local devcontainer_json="$target_dir/.devcontainer/devcontainer.json"
    local hooks_initialize="$target_dir/.devcontainer/hooks-initialize.sh"
    local hooks_post_start="$target_dir/.devcontainer/hooks-post-start.sh"
    local gitignore_path="$target_dir/.gitignore"

    if [[ ! -f "$dockerfile_path" || ! -f "$devcontainer_json" ]]; then
        echo "エラー: init済みのvibeboxプロジェクトではありません。" >&2
        echo "必要なファイル: .vibebox/Dockerfile, .devcontainer/devcontainer.json" >&2
        echo "'vibebox init' を先に実行してください。" >&2
        exit 1
    fi

    if ! command -v jq &> /dev/null; then
        echo "エラー: jqがインストールされていません。jqをインストールしてください。" >&2
        exit 1
    fi

    if [[ ! -f "$hooks_post_start" ]]; then
        echo "エラー: hooks-post-start.shが見つかりません: $hooks_post_start" >&2
        echo "'vibebox init' で生成された .devcontainer/hooks-post-start.sh が必要です。" >&2
        exit 1
    fi

    local cleaned_json
    cleaned_json=$(clean_jsonc_file "$devcontainer_json")
    if ! printf '%s\n' "$cleaned_json" | jq . >/dev/null 2>&1; then
        echo "エラー: devcontainer.json の構文チェックに失敗しました。" >&2
        exit 1
    fi

    local remote_user
    remote_user=$(printf '%s\n' "$cleaned_json" | jq -r '.remoteUser // empty' 2>/dev/null)
    if [[ -z "$remote_user" || "$remote_user" == "null" ]]; then
        remote_user="${VIBEBOX_CONTAINER_USERNAME:-vibebox}"
    fi

    local repo_name
    repo_name="$(basename "$target_dir")"

    local temp_dir
    temp_dir=$(mktemp -d)
    trap 'rm -rf "$temp_dir"' RETURN

    local updated_dockerfile="$temp_dir/Dockerfile"
    local updated_devcontainer="$temp_dir/devcontainer.json"
    local updated_hooks_initialize="$temp_dir/hooks-initialize.sh"
    local updated_hooks="$temp_dir/hooks-post-start.sh"
    local updated_gitignore="$temp_dir/gitignore"
    local hooks_initialize_source="$hooks_initialize"
    if [[ ! -f "$hooks_initialize_source" ]]; then
        hooks_initialize_source="$temp_dir/hooks-initialize.original"
        : > "$hooks_initialize_source"
    fi
    local gitignore_source="$gitignore_path"
    if [[ ! -f "$gitignore_source" ]]; then
        gitignore_source="$temp_dir/gitignore.original"
        : > "$gitignore_source"
    fi

    generate_updated_dockerfile "$dockerfile_path" "$updated_dockerfile"
    generate_updated_devcontainer_json "$devcontainer_json" "$updated_devcontainer" "$remote_user" "$repo_name"
    generate_updated_hooks_initialize "$updated_hooks_initialize"
    generate_updated_hooks_post_start "$hooks_post_start" "$updated_hooks"
    generate_updated_gitignore "$gitignore_source" "$updated_gitignore"

    local changes=0
    cmp -s "$dockerfile_path" "$updated_dockerfile" || changes=$((changes + 1))
    cmp -s "$devcontainer_json" "$updated_devcontainer" || changes=$((changes + 1))
    cmp -s "$hooks_initialize_source" "$updated_hooks_initialize" || changes=$((changes + 1))
    cmp -s "$hooks_post_start" "$updated_hooks" || changes=$((changes + 1))
    cmp -s "$gitignore_source" "$updated_gitignore" || changes=$((changes + 1))

    echo "更新対象:"
    echo "  - .vibebox/Dockerfile"
    echo "  - .devcontainer/devcontainer.json"
    echo "  - .devcontainer/hooks-initialize.sh"
    echo "  - .devcontainer/hooks-post-start.sh"
    echo "  - .gitignore"
    echo
    echo "SSHユーザー: $remote_user"
    echo "変更が必要なファイル数: $changes"
    echo

    if [[ "$changes" -eq 0 ]]; then
        echo "更新は不要です。"
        return 0
    fi

    if [[ "$dry_run" == "true" ]]; then
        echo "=== dry-run: 変更内容 ==="
    elif [[ "$assume_yes" != "true" ]]; then
        read -p "上記の設定を更新しますか？ (y/N): " -r
        if [[ ! $REPLY =~ ^[Yy]$ ]]; then
            echo "更新を中止しました。"
            return 0
        fi
    fi

    local timestamp
    timestamp=$(date +%Y%m%d%H%M%S)

    write_updated_file "$dockerfile_path" "$updated_dockerfile" "$dry_run" "$timestamp" || true
    write_updated_file "$devcontainer_json" "$updated_devcontainer" "$dry_run" "$timestamp" || true
    write_updated_file "$hooks_initialize_source" "$updated_hooks_initialize" "$dry_run" "$timestamp" "$hooks_initialize" || true
    write_updated_file "$hooks_post_start" "$updated_hooks" "$dry_run" "$timestamp" || true
    write_updated_file "$gitignore_source" "$updated_gitignore" "$dry_run" "$timestamp" "$gitignore_path" || true

    if [[ "$dry_run" == "true" ]]; then
        echo
        echo "dry-runのためファイルは変更していません。"
        return 0
    fi

    chmod +x "$hooks_initialize"
    chmod +x "$hooks_post_start"

    echo
    echo "=== 更新完了 ==="
    echo "次のステップ:"
    echo "1. 'vibebox container build' でDockerイメージを再ビルドしてください"
    echo "2. 既存の稼働中コンテナは停止・再作成してください"
    echo "3. 起動後、以下の形式でSSH接続できます:"
    echo "   ssh ${remote_user}@vibebox.<repo>.<branch>.orb.local"
}

# cleanupコマンド
cleanup_worktrees() {
    echo "=== vibeboxコンテナとワークスペースを削除 ==="
    echo

    # gitリポジトリかどうかチェック
    if [[ ! -d "$PROJECT_ROOT/.git" ]]; then
        echo "エラー: プロジェクトルートがgitリポジトリではありません" >&2
        exit 1
    fi

    local vibebox_dir="$PROJECT_ROOT/.vibebox-workspaces"

    # vibebox-workspacesディレクトリが存在するかチェック
    if [[ ! -d "$vibebox_dir" ]]; then
        echo "削除対象のvibeboxワークスペースは見つかりませんでした。"
        echo "ディレクトリ: $vibebox_dir"
        return 0
    fi

    echo "vibeboxディレクトリ: $vibebox_dir"
    echo

    # 既存のワークスペースを一覧表示
    echo "削除対象のワークスペース："
    local workspace_count=0
    if [[ -d "$vibebox_dir" ]]; then
        for workspace_path in "$vibebox_dir"/*; do
            if [[ -d "$workspace_path" ]]; then
                local branch_name
                branch_name=$(basename "$workspace_path")
                echo "  - $branch_name ($workspace_path)"
                workspace_count=$((workspace_count + 1))
            fi
        done
    fi

    local vibebox_container_ids
    vibebox_container_ids=$(docker_cmd ps -a --format '{{.ID}} {{.Image}}' 2>/dev/null | awk '$2 ~ /^vibebox/ {print $1}')

    local container_count=0
    if [[ -n "$vibebox_container_ids" ]]; then
        container_count=$(printf '%s\n' "$vibebox_container_ids" | awk 'NF {count++} END {print count+0}')
    fi

    echo
    echo "削除対象のコンテナ: $container_count 個"
    echo "削除対象のワークスペース: $workspace_count 個"
    if [[ $container_count -eq 0 && $workspace_count -eq 0 ]]; then
        echo "削除対象はありません。"
        return 0
    fi
    echo

    # 確認プロンプト
    read -p "本当にすべてのvibeboxコンテナとワークスペースを削除しますか？ (y/N): " -r
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        echo "クリーンアップを中止しました。"
        exit 0
    fi

    echo
    echo "コンテナを削除中..."

    local removed_container_count=0
    if [[ -n "$vibebox_container_ids" ]]; then
        while IFS= read -r container_id; do
            if [[ -n "$container_id" ]]; then
                echo "  削除中: $container_id"
                if docker_cmd rm -f "$container_id" >/dev/null 2>&1; then
                    echo "    ✓ コンテナを削除しました"
                    removed_container_count=$((removed_container_count + 1))
                else
                    echo "    ✗ コンテナの削除に失敗しました"
                fi
            fi
        done <<< "$vibebox_container_ids"
    fi

    echo
    echo "ワークスペースを削除中..."

    # cloneされたワークスペースを削除
    local removed_count=0
    local error_count=0

    for workspace_path in "$vibebox_dir"/*; do
        if [[ -d "$workspace_path" ]]; then
            local branch_name
            branch_name=$(basename "$workspace_path")

            echo "  削除中: $branch_name"

            # ワークスペースディレクトリを直接削除
            if rm -rf "$workspace_path" 2>/dev/null; then
                echo "    ✓ ワークスペースを削除しました"
                removed_count=$((removed_count + 1))
            else
                echo "    ✗ ワークスペースの削除に失敗しました"
                error_count=$((error_count + 1))
            fi
        fi
    done

    # vibebox-workspacesディレクトリ自体が空になった場合は削除
    if [[ -d "$vibebox_dir" ]] && [[ -z "$(ls -A "$vibebox_dir" 2>/dev/null)" ]]; then
        echo "  空のvibeboxディレクトリを削除: $vibebox_dir"
        rmdir "$vibebox_dir" 2>/dev/null || true
    fi

    echo
    echo "=== クリーンアップ完了 ==="
    echo "削除されたコンテナ: $removed_container_count 個"
    echo "削除されたワークスペース: $removed_count 個"
    if [[ $error_count -gt 0 ]]; then
        echo "削除に失敗したワークスペース: $error_count 個"
    fi

    echo
    echo "すべてのvibeboxワークスペースの削除が完了しました。"
}

# rmコマンド - 単一ワークスペースの削除
remove_workspace() {
    echo "=== vibeboxワークスペースを削除 ==="
    local branch_name="$1"

    # ブランチ名が省略された場合、カレントディレクトリから自動取得を試行
    if [[ -z "$branch_name" ]]; then
        branch_name=$(get_current_branch_name)
        if [[ -z "$branch_name" ]]; then
            echo "エラー: ブランチ名が指定されておらず、カレントディレクトリからも自動取得できませんでした" >&2
            echo "ワークスペースディレクトリ内で実行するか、ブランチ名を明示的に指定してください" >&2
            exit 1
        fi
        echo "カレントディレクトリから自動取得したブランチ名: $branch_name"
    fi

    # gitリポジトリかどうかチェック
    if [[ ! -d "$PROJECT_ROOT/.git" ]]; then
        echo "エラー: プロジェクトルートがgitリポジトリではありません" >&2
        exit 1
    fi

    local workspace_path="$PROJECT_ROOT/.vibebox-workspaces/$branch_name"
    if [[ ! -d "$workspace_path" ]]; then
        echo "エラー: ワークスペースが見つかりません: $workspace_path" >&2
        exit 1
    fi

    echo "対象ワークスペース: $workspace_path"

    # 対応するコンテナが稼働中かチェック
    local git_repo_name
    git_repo_name=$(basename "$PROJECT_ROOT")
    local sanitized_branch="${branch_name//\//-}"
    local expected_container_name="vibebox.${git_repo_name}.${sanitized_branch}"
    local container_id
    container_id="$(docker_find_running_container_id_by_name "$expected_container_name" || true)"

    if [[ -n "$container_id" ]]; then
        echo "⚠️  ブランチ '$branch_name' のvibeboxコンテナが稼働中です: $expected_container_name ($container_id)"
        echo "  先にセッションを停止するには: $0 down $branch_name"
    fi

    # 確認プロンプト
    read -p "本当にワークスペース '$branch_name' を削除しますか？ (y/N): " -r
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        echo "削除を中止しました。"
        exit 0
    fi

    # 稼働中のコンテナがある場合の追加確認
    if [[ -n "$container_id" ]]; then
        read -p "コンテナを停止せずに削除を続行しますか？ (y/N): " -r
        if [[ ! $REPLY =~ ^[Yy]$ ]]; then
            echo "削除を中止しました。"
            exit 1
        fi
    fi

    if remove_workspace_directory "$branch_name"; then
        return 0
    else
        exit 1
    fi
}

# doctor コマンド - 環境チェック
doctor_check() {
    echo "=== vibebox 環境診断 ==="
    echo

    local overall_status="OK"
    local warning_count=0
    local error_count=0

    # チェック結果を記録するための関数
    log_check() {
        local status="$1"
        local message="$2"
        local details="$3"

        case "$status" in
            "OK")
                echo "✓ $message"
                ;;
            "WARNING")
                echo "⚠️  $message"
                warning_count=$((warning_count + 1))
                if [[ "$overall_status" == "OK" ]]; then
                    overall_status="WARNING"
                fi
                ;;
            "ERROR")
                echo "✗ $message"
                error_count=$((error_count + 1))
                overall_status="ERROR"
                ;;
        esac

        if [[ -n "$details" ]]; then
            echo "   $details"
        fi
    }

    echo "■ 基本環境チェック"
    echo

    # gitリポジトリチェック
    if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        log_check "OK" "Gitリポジトリ"

        # リモートoriginの存在チェック
        if git remote get-url origin >/dev/null 2>&1; then
            local remote_url
            remote_url=$(git remote get-url origin)
            log_check "OK" "Gitリモート (origin): $remote_url"
        else
            log_check "ERROR" "Gitリモート (origin) が設定されていません"
            echo "   git remote add origin <repository-url> で設定してください"
        fi
    else
        log_check "ERROR" "カレントディレクトリがGitリポジトリではありません"
        echo "   git init でリポジトリを初期化するか、Gitリポジトリ内で実行してください"
    fi

    # プロジェクトルートの確認
    if [[ -n "$PROJECT_ROOT" ]]; then
        log_check "OK" "プロジェクトルート: $PROJECT_ROOT"
    else
        log_check "ERROR" "プロジェクトルートを特定できません"
    fi

    echo
    echo "■ vibebox 設定チェック"
    echo

    # .vibeboxディレクトリ
    if [[ -d "$PROJECT_ROOT/.vibebox" ]]; then
        log_check "OK" ".vibeboxディレクトリ"

        # Dockerfile
        if [[ -f "$PROJECT_ROOT/.vibebox/Dockerfile" ]]; then
            log_check "OK" "Dockerfile"
        else
            log_check "ERROR" "Dockerfileが見つかりません"
            echo "   'vibebox init' でセットアップするか、手動で作成してください"
        fi
    else
        log_check "ERROR" ".vibeboxディレクトリが存在しません"
        echo "   'vibebox init' を実行してセットアップしてください"
    fi

    # .devcontainerディレクトリ
    if [[ -d "$PROJECT_ROOT/.devcontainer" ]]; then
        log_check "OK" ".devcontainerディレクトリ"

        # devcontainer.json
        if [[ -f "$PROJECT_ROOT/.devcontainer/devcontainer.json" ]]; then
            log_check "OK" "devcontainer.json"

                                    # JSONファイルの妥当性チェック（JSONC対応）
            if command -v jq &> /dev/null; then
                # コメント、末尾のカンマを除去してクリーンなJSONを作成
                local cleaned_json
                cleaned_json=$(sed 's://.*$::g; s:/\*.*\*/::g' "$PROJECT_ROOT/.devcontainer/devcontainer.json" | \
                              sed 's/,\s*\]/]/g; s/,\s*}/}/g' 2>/dev/null)

                if [[ -n "$cleaned_json" ]] && echo "$cleaned_json" | jq . >/dev/null 2>&1; then
                    log_check "OK" "devcontainer.json 構文チェック（JSONC対応）"

                    # devcontainer.jsonの内容を詳細チェック
                    echo
                    echo "  ● devcontainer.json 詳細設定チェック"

                    # Claude関連ファイルのマウントチェック
                    local claude_mount_count=0
                    if echo "$cleaned_json" | jq -r '.mounts[]?' 2>/dev/null | grep -q "\.claude,target="; then
                        log_check "OK" "  Claude設定ディレクトリマウント (.claude)"
                        claude_mount_count=$((claude_mount_count + 1))
                    else
                        log_check "WARNING" "  Claude設定ディレクトリマウントが見つかりません (.claude)"
                    fi

                    if echo "$cleaned_json" | jq -r '.mounts[]?' 2>/dev/null | grep -q "\.claude\.json,target="; then
                        log_check "OK" "  Claude設定ファイルマウント (.claude.json)"
                        claude_mount_count=$((claude_mount_count + 1))
                    else
                        log_check "WARNING" "  Claude設定ファイルマウントが見つかりません (.claude.json)"
                    fi

                    # GitHub認証情報のマウントチェック
                    if echo "$cleaned_json" | jq -r '.mounts[]?' 2>/dev/null | grep -q "devcontainer-gh-config"; then
                        log_check "OK" "  GitHub認証情報マウント (gh config)"
                    else
                        log_check "WARNING" "  GitHub認証情報マウントが見つかりません"
                        echo "     source=devcontainer-gh-config-\${localEnv:USER} の設定を確認してください"
                    fi

                    # zsh_historyのマウントチェック
                    if echo "$cleaned_json" | jq -r '.mounts[]?' 2>/dev/null | grep -q "\.zsh_history"; then
                        log_check "OK" "  zsh履歴ファイルマウント (.zsh_history)"
                    else
                        log_check "WARNING" "  zsh履歴ファイルマウントが見つかりません"
                        echo "     .devcontainer/.zsh_history のマウント設定を確認してください"
                    fi

                    # ワークスペースディレクトリチェック
                    local workspace_folder
                    workspace_folder=$(echo "$cleaned_json" | jq -r '.workspaceFolder // empty' 2>/dev/null)
                    if [[ "$workspace_folder" == "/workspace" ]]; then
                        log_check "OK" "  ワークスペースディレクトリ: $workspace_folder"
                    else
                        log_check "WARNING" "  ワークスペースディレクトリが /workspace ではありません: $workspace_folder"
                        echo "     workspaceFolder を /workspace に設定することを推奨します"
                    fi

                    # Dockerイメージチェック
                    local image_name
                    image_name=$(echo "$cleaned_json" | jq -r '.image // empty' 2>/dev/null)
                    if [[ "$image_name" =~ vibebox ]]; then
                        log_check "OK" "  Dockerイメージ: vibebox由来 ($image_name)"
                    else
                        log_check "WARNING" "  Dockerイメージがvibebox由来ではありません: $image_name"
                        echo "     振り返りイメージにvibeboxが含まれることを推奨します"
                    fi

                    # initializeCommandチェック
                    local initialize_command
                    initialize_command=$(echo "$cleaned_json" | jq -r '.initializeCommand[]? // empty' 2>/dev/null | tr '\n' ' ')
                    if [[ -n "$initialize_command" ]]; then
                        log_check "OK" "  initializeCommand設定あり"

                        # GitHub userの出力チェック
                        if echo "$initialize_command" | grep -q "gh api user.*\.github-user"; then
                            log_check "OK" "    GitHub user情報の取得設定"
                        else
                            log_check "WARNING" "    GitHub user情報の取得設定が見つかりません"
                            echo "       'gh api user -q .login > .devcontainer/.github-user' の設定を確認してください"
                        fi

                        # .zsh_historyファイル作成チェック
                        if echo "$initialize_command" | grep -q "touch.*\.zsh_history"; then
                            log_check "OK" "    zsh履歴ファイル作成設定"
                        else
                            log_check "WARNING" "    zsh履歴ファイル作成設定が見つかりません"
                            echo "       'touch .devcontainer/.zsh_history' の設定を確認してください"
                        fi
                    else
                        log_check "WARNING" "  initializeCommandが設定されていません"
                        echo "     GitHub認証とzsh履歴ファイルの初期化設定を推奨します"
                    fi

                    # postStartCommandチェック
                    local post_start_command
                    post_start_command=$(echo "$cleaned_json" | jq -r '.postStartCommand // empty' 2>/dev/null)
                    if [[ -n "$post_start_command" ]]; then
                        log_check "OK" "  postStartCommand設定あり"

                        # hooks-post-start.shの実行チェック
                        if echo "$post_start_command" | grep -q "hooks-post-start\.sh"; then
                            log_check "OK" "    hooks-post-start.sh実行設定"
                        else
                            log_check "WARNING" "    hooks-post-start.sh実行設定が見つかりません"
                            echo "       hooks-post-start.shの実行設定を確認してください"
                        fi
                    else
                        log_check "WARNING" "  postStartCommandが設定されていません"
                        echo "     hooks-post-start.shの実行設定を推奨します"
                    fi

                    # remoteUserチェック
                    local remote_user
                    remote_user=$(echo "$cleaned_json" | jq -r '.remoteUser // empty' 2>/dev/null)
                    if [[ -n "$remote_user" ]]; then
                        log_check "OK" "  リモートユーザー: $remote_user"
                    else
                        log_check "WARNING" "  リモートユーザーが設定されていません"
                    fi

                else
                    log_check "WARNING" "devcontainer.json の構文チェックに失敗しました"
                    echo "   JSONCファイル（コメント付きJSON）として処理されますが、構文に問題がある可能性があります"
                fi
            else
                log_check "WARNING" "jqがインストールされていないため、JSON構文チェックをスキップ"
            fi
        else
            log_check "ERROR" "devcontainer.jsonが見つかりません"
            echo "   'vibebox init' でセットアップするか、手動で作成してください"
        fi

        # 推奨スクリプトファイル
        local optional_scripts=(
            "hooks-post-start.sh"
            "ecr-login.sh"
        )

        for script in "${optional_scripts[@]}"; do
            if [[ -f "$PROJECT_ROOT/.devcontainer/$script" ]]; then
                log_check "OK" "devcontainerスクリプト: $script"

                # 実行権限チェック
                if [[ -x "$PROJECT_ROOT/.devcontainer/$script" ]]; then
                    log_check "OK" "実行権限: $script"
                else
                    log_check "WARNING" "実行権限がありません: $script"
                    echo "   chmod +x .devcontainer/$script で権限を付与してください"
                fi
            else
                log_check "WARNING" "推奨スクリプトが見つかりません: $script"
                echo "   このファイルは初期化処理で使用されます"
            fi
        done

    else
        log_check "ERROR" ".devcontainerディレクトリが存在しません"
        echo "   'vibebox init' を実行してセットアップしてください"
    fi

    echo
    echo "■ 依存ツールチェック"
    echo

    # Docker
    if command -v docker &> /dev/null; then
        if docker info >/dev/null 2>&1; then
            local docker_version
            docker_version=$(docker --version | grep -o 'Docker version [0-9.]*' | cut -d' ' -f3)
            log_check "OK" "Docker ($docker_version) - 稼働中"
        else
            log_check "ERROR" "Dockerがインストールされていますが、稼働していません"
            echo "   Docker Desktopを起動するか、Dockerデーモンを開始してください"
        fi
    else
        log_check "ERROR" "Dockerがインストールされていません"
        echo "   https://www.docker.com/get-started からDockerをインストールしてください"
    fi

    # devcontainer CLI
    if command -v devcontainer &> /dev/null; then
        local devcontainer_version
        devcontainer_version=$(devcontainer --version 2>/dev/null | head -1)
        log_check "OK" "devcontainer CLI ($devcontainer_version)"
    else
        log_check "ERROR" "devcontainer CLIがインストールされていません"
        echo "   npm install -g @devcontainers/cli でインストールしてください"
    fi

    # jq
    if command -v jq &> /dev/null; then
        local jq_version
        jq_version=$(jq --version 2>/dev/null)
        log_check "OK" "jq ($jq_version)"
    else
        log_check "ERROR" "jqがインストールされていません"
        echo "   brew install jq または apt-get install jq でインストールしてください"
    fi

    # tmux (推奨)
    if command -v tmux &> /dev/null; then
        local tmux_version
        tmux_version=$(tmux -V 2>/dev/null)
        log_check "OK" "tmux ($tmux_version) - セッション管理に使用"
    else
        log_check "WARNING" "tmuxがインストールされていません（推奨）"
        echo "   brew install tmux または apt-get install tmux でインストールすることを推奨"
    fi

    # cursor (推奨)
    if command -v cursor &> /dev/null; then
        log_check "OK" "Cursor - エディタ連携に使用"
    else
        log_check "WARNING" "Cursorがインストールされていません（推奨）"
        echo "   https://cursor.sh からCursorをインストールすることを推奨"
    fi

    # git設定チェック
    if command -v git &> /dev/null; then
        local git_version
        git_version=$(git --version | cut -d' ' -f3)
        log_check "OK" "Git ($git_version)"

        # git設定の確認
        local git_user_name
        local git_user_email
        git_user_name=$(git config user.name 2>/dev/null)
        git_user_email=$(git config user.email 2>/dev/null)

        if [[ -n "$git_user_name" ]]; then
            log_check "OK" "Git user.name: $git_user_name"
        else
            log_check "WARNING" "Git user.name が設定されていません"
            echo "   git config --global user.name 'Your Name' で設定してください"
        fi

        if [[ -n "$git_user_email" ]]; then
            log_check "OK" "Git user.email: $git_user_email"
        else
            log_check "WARNING" "Git user.email が設定されていません"
            echo "   git config --global user.email 'your.email@example.com' で設定してください"
        fi
    fi

    echo
    echo "■ AWS/ECR 設定チェック（push機能用）"
    echo

    # AWS CLI
    if command -v aws &> /dev/null; then
        local aws_version
        aws_version=$(aws --version 2>&1 | cut -d' ' -f1)
        log_check "OK" "AWS CLI ($aws_version)"

        # AWS認証情報の確認
        if aws sts get-caller-identity >/dev/null 2>&1; then
            local aws_account
            aws_account=$(aws sts get-caller-identity --query Account --output text 2>/dev/null)
            log_check "OK" "AWS認証情報 (アカウント: $aws_account)"
        else
            log_check "WARNING" "AWS認証情報が設定されていません"
            echo "   aws configure でAWS認証情報を設定してください（ECRプッシュ時に必要）"
        fi

        # envchain確認
        if command -v envchain &> /dev/null; then
            log_check "OK" "envchain - AWS認証情報管理に使用"
        else
            log_check "WARNING" "envchainがインストールされていません（推奨）"
            echo "   brew install envchain でインストールすることを推奨"
        fi
    else
        log_check "WARNING" "AWS CLIがインストールされていません"
        echo "   ECRプッシュ機能を使用する場合は AWS CLI が必要です"
        echo "   https://aws.amazon.com/cli/ からインストールしてください"
    fi

    echo
    echo "■ 権限・設定チェック"
    echo

    # 現在のユーザーがdockerグループに属しているか（Linux）
    if [[ "$(uname)" != "Darwin" ]]; then
        if groups | grep -q docker; then
            log_check "OK" "Dockerグループメンバーシップ"
        else
            log_check "WARNING" "ユーザーがdockerグループに属していません"
            echo "   sudo usermod -aG docker \$USER でグループに追加し、再ログインしてください"
        fi
    fi

    # HOME/.claude ディレクトリ（devcontainerマウント用）
    if [[ -d "$HOME/.claude" ]]; then
        log_check "OK" "Claude設定ディレクトリ: $HOME/.claude"
    else
        log_check "WARNING" "Claude設定ディレクトリが見つかりません: $HOME/.claude"
        echo "   Claude Desktop使用時に設定が引き継がれない可能性があります"
    fi

    # .env ファイル
    if [[ -f "$PROJECT_ROOT/.env" ]]; then
        log_check "OK" ".envファイル"
    else
        log_check "WARNING" ".envファイルが見つかりません"
        echo "   環境変数が必要な場合は .env ファイルを作成してください"
    fi

    echo
    echo "■ 既存ワークスペース・コンテナ状況"
    echo

    # 既存のワークスペース
    local workspace_dir="$PROJECT_ROOT/.vibebox-workspaces"
    if [[ -d "$workspace_dir" ]]; then
        local workspace_count
        workspace_count=$(find "$workspace_dir" -maxdepth 1 -type d | wc -l)
        workspace_count=$((workspace_count - 1)) # ディレクトリ自体を除く

        if [[ $workspace_count -gt 0 ]]; then
            log_check "OK" "既存ワークスペース: $workspace_count 個"
            echo "   '$0 list' で詳細を確認できます"
        else
            log_check "OK" "ワークスペースディレクトリ（空）"
        fi
    else
        log_check "OK" "ワークスペースなし（初回セットアップ）"
    fi

    # 稼働中のvibeboxコンテナ
    if command -v docker &> /dev/null && docker info >/dev/null 2>&1; then
        local git_repo_name
        git_repo_name=$(basename "$PROJECT_ROOT" 2>/dev/null)

        if [[ -n "$git_repo_name" ]]; then
            local running_containers
            running_containers=$(docker ps --filter "name=vibebox.${git_repo_name}" --format "{{.ID}}" 2>/dev/null | wc -l)

            if [[ $running_containers -gt 0 ]]; then
                log_check "OK" "稼働中のvibeboxコンテナ: $running_containers 個"
                echo "   '$0 list' で詳細を確認できます"
            else
                log_check "OK" "稼働中のvibeboxコンテナなし"
            fi
        fi
    fi

    echo
    echo "=== 診断結果サマリー ==="
    echo

    case "$overall_status" in
        "OK")
            echo "🎉 すべてのチェックが正常に完了しました。vibeboxを使用する準備ができています。"
            ;;
        "WARNING")
            echo "⚠️  $warning_count 個の警告があります。基本機能は使用できますが、一部機能で制限がある可能性があります。"
            ;;
        "ERROR")
            echo "❌ $error_count 個のエラーがあります。vibeboxを正常に使用するには修正が必要です。"
            ;;
    esac

    if [[ $warning_count -gt 0 || $error_count -gt 0 ]]; then
        echo
        echo "推奨アクション:"
        if [[ $error_count -gt 0 ]]; then
            echo "1. 上記のエラー項目を修正してください"
            echo "2. 修正後、'$0 doctor' を再実行して確認してください"
        fi
        if [[ $warning_count -gt 0 ]]; then
            echo "1. 警告項目の修正を検討してください（機能向上のため）"
        fi
        echo "3. 問題が解決しない場合は、'$0 init' でセットアップを再実行してください"
    else
        echo
        echo "次のステップ:"
        echo "1. '$0 container build' - Dockerイメージのビルド"
        echo "2. '$0 up [branch-name]' - 開発セッションの開始"
    fi

    echo
}

# メイン処理
main() {
    # 引数がない場合はヘルプを表示
    if [[ $# -eq 0 ]]; then
        show_usage
        exit 1
    fi

    case "$1" in
        init)
            shift

            # オプション解析
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --help|-h)
                        show_usage
                        exit 0
                        ;;
                    *)
                        echo "エラー: 不明なオプション: $1" >&2
                        show_usage
                        exit 1
                        ;;
                esac
            done

            init_vibebox
            ;;
        update)
            shift
            local dry_run="false"
            local assume_yes="false"

            # オプション解析
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --dry-run)
                        dry_run="true"
                        shift
                        ;;
                    --yes|-y)
                        assume_yes="true"
                        shift
                        ;;
                    --help|-h)
                        show_usage
                        exit 0
                        ;;
                    *)
                        echo "エラー: 不明なオプション: $1" >&2
                        show_usage
                        exit 1
                        ;;
                esac
            done

            update_vibebox "$dry_run" "$assume_yes"
            ;;
        container)
            if [[ "$2" != "build" && "$2" != "tag" && "$2" != "push" ]]; then
                echo "エラー: 'container' コマンドには 'build'、'tag'、または 'push' サブコマンドが必要です" >&2
                show_usage
                exit 1
            fi
            local subcommand="$2"
            shift 2

            case "$subcommand" in
                build)
                    local custom_tag=""
                    local use_aws_env="false"
                    local no_cache="false"
                    local custom_build_args=()

                    # オプション解析
                    while [[ $# -gt 0 ]]; do
                        case "$1" in
                            --tag)
                                custom_tag="$2"
                                shift 2
                                ;;
                            --build-arg)
                                custom_build_args+=(--build-arg "$2")
                                shift 2
                                ;;
                            --no-cache)
                                no_cache="true"
                                shift
                                ;;
                            --help|-h)
                                show_usage
                                exit 0
                                ;;
                            *)
                                echo "エラー: 不明なオプション: $1" >&2
                                show_usage
                                exit 1
                                ;;
                        esac
                    done

                    # タグを決定
                    if [[ -n "$custom_tag" ]]; then
                        TAG="$custom_tag"
                    fi

                    build_image "$TAG" "$use_aws_env" "$no_cache" "${custom_build_args[@]}"
                    ;;
                tag)
                    container_tag_command "$@"
                    ;;
                push)
                    local custom_tag=""

                    # オプション解析
                    while [[ $# -gt 0 ]]; do
                        case "$1" in
                            --tag)
                                custom_tag="$2"
                                shift 2
                                ;;
                            --help|-h)
                                show_usage
                                exit 0
                                ;;
                            *)
                                echo "エラー: 不明なオプション: $1" >&2
                                show_usage
                                exit 1
                                ;;
                        esac
                    done

                    # タグを決定
                    if [[ -n "$custom_tag" ]]; then
                        TAG="$custom_tag"
                    fi

                    push_image "$TAG"
                    ;;
            esac
            ;;
        up|open)
            shift
            local branch_name=""
            local attach_flag="true"

            # 最初の引数がブランチ名
            if [[ $# -gt 0 && "$1" != --* ]]; then
                branch_name="$1"
                shift
            fi

            # オプション解析
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --no-attach)
                        attach_flag="false"
                        shift
                        ;;
                    --help|-h)
                        show_usage
                        exit 0
                        ;;
                    *)
                        echo "エラー: 不明なオプション: $1" >&2
                        show_usage
                        exit 1
                        ;;
                esac
            done

            if [[ -z "$branch_name" ]]; then
                branch_name="default"
            fi

            start_session "$branch_name" "$attach_flag"
            ;;
        list|ls)
            shift

            # オプション解析（将来拡張用）
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --help|-h)
                        show_usage
                        exit 0
                        ;;
                    *)
                        echo "エラー: 不明なオプション: $1" >&2
                        show_usage
                        exit 1
                        ;;
                esac
            done

            # これまでの list（セッション一覧）は廃止し、
            # ワークスペース一覧（ws ls）に委譲します。
            list_workspaces
            ;;
        attach)
            shift
            local branch_name=""

            # 最初の引数がブランチ名
            if [[ $# -gt 0 && "$1" != --* ]]; then
                branch_name="$1"
                shift
            fi

            # オプション解析
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --help|-h)
                        show_usage
                        exit 0
                        ;;
                    *)
                        echo "エラー: 不明なオプション: $1" >&2
                        show_usage
                        exit 1
                        ;;
                esac
            done

            # ブランチ名の有無に関わらずattach_sessionを呼び出す
            attach_session "$branch_name"
            ;;
        down|close)
            shift
            local branch_name=""
            local stop_all="false"
            local remove_workspace="false"

            # オプション解析
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --all)
                        stop_all="true"
                        shift
                        ;;
                    --rm)
                        remove_workspace="true"
                        shift
                        ;;
                    --help|-h)
                        show_usage
                        exit 0
                        ;;
                    *)
                        # ブランチ名を取得
                        if [[ -z "$branch_name" ]]; then
                            branch_name="$1"
                            shift
                        else
                            echo "エラー: 不明なオプション: $1" >&2
                            show_usage
                            exit 1
                        fi
                        ;;
                esac
            done

            # --allオプションが指定された場合
            if [[ "$stop_all" == "true" ]]; then
                stop_all_sessions "$remove_workspace"
            else
                if [[ -z "$branch_name" ]]; then
                    branch_name="default"
                fi
                stop_session "$branch_name" "$remove_workspace"
            fi
            ;;
        shell)
            shift
            local branch_name=""

            # 最初の引数がブランチ名
            if [[ $# -gt 0 && "$1" != --* ]]; then
                branch_name="$1"
                shift
            fi

            # オプション解析
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --help|-h)
                        show_usage
                        exit 0
                        ;;
                    *)
                        echo "エラー: 不明なオプション: $1" >&2
                        show_usage
                        exit 1
                        ;;
                esac
            done

            # ブランチ名が指定されていない場合でも、shell_session内で自動取得を試行
            shell_session "$branch_name"
            ;;
        edit)
            shift
            local branch_name=""

            # 最初の引数がブランチ名
            if [[ $# -gt 0 && "$1" != --* ]]; then
                branch_name="$1"
                shift
            fi

            # オプション解析
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --help|-h)
                        show_usage
                        exit 0
                        ;;
                    *)
                        echo "エラー: 不明なオプション: $1" >&2
                        show_usage
                        exit 1
                        ;;
                esac
            done

            # ブランチ名が指定されていない場合でも、edit_session内で自動取得を試行
            edit_session "$branch_name"
            ;;
        cd)
            shift
            local branch_name=""

            if [[ $# -gt 0 && "$1" != --* ]]; then
                branch_name="$1"
                shift
            fi

            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --help|-h)
                        show_usage
                        exit 0
                        ;;
                    *)
                        echo "エラー: 不明なオプション: $1" >&2
                        show_usage
                        exit 1
                        ;;
                esac
            done

            cd_local_session "$branch_name"
            ;;
        clean|cleanup)
            shift

            # オプション解析
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --help|-h)
                        show_usage
                        exit 0
                        ;;
                    *)
                        echo "エラー: 不明なオプション: $1" >&2
                        show_usage
                        exit 1
                        ;;
                esac
            done

            cleanup_worktrees
            ;;
        link)
            shift

            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --help|-h)
                        show_usage
                        exit 0
                        ;;
                    *)
                        echo "エラー: 不明なオプション: $1" >&2
                        show_usage
                        exit 1
                        ;;
                esac
            done

            link_vibebox_command
            ;;
        doctor)
            shift

            # オプション解析
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --help|-h)
                        show_usage
                        exit 0
                        ;;
                    *)
                        echo "エラー: 不明なオプション: $1" >&2
                        show_usage
                        exit 1
                        ;;
                esac
            done

            doctor_check
            ;;
        workspace|ws)
            if [[ "$2" != "list" && "$2" != "ls" ]]; then
                echo "エラー: 'workspace' コマンドには 'list' または 'ls' サブコマンドが必要です" >&2
                show_usage
                exit 1
            fi
            local subcommand="$2"
            shift 2

            case "$subcommand" in
                list|ls)
                    # オプション解析
                    while [[ $# -gt 0 ]]; do
                        case "$1" in
                            --help|-h)
                                show_usage
                                exit 0
                                ;;
                            *)
                                echo "エラー: 不明なオプション: $1" >&2
                                show_usage
                                exit 1
                                ;;
                        esac
                    done

                    list_workspaces
                    ;;
            esac
            ;;
        secrets)
            if [[ "$2" != "set" ]]; then
                echo "エラー: 'secrets' コマンドには 'set' サブコマンドが必要です" >&2
                show_usage
                exit 1
            fi
            shift 2

            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --help|-h)
                        show_usage
                        exit 0
                        ;;
                    *)
                        echo "エラー: 不明なオプション: $1" >&2
                        show_usage
                        exit 1
                        ;;
                esac
            done

            secrets_set
            ;;
        rm)
            shift
            local branch_name=""

            # 最初の引数がブランチ名
            if [[ $# -gt 0 && "$1" != --* ]]; then
                branch_name="$1"
                shift
            fi

            # オプション解析
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --help|-h)
                        show_usage
                        exit 0
                        ;;
                    *)
                        echo "エラー: 不明なオプション: $1" >&2
                        show_usage
                        exit 1
                        ;;
                esac
            done

            if [[ -z "$branch_name" ]]; then
                branch_name="default"
            fi

            remove_workspace "$branch_name"
            ;;
        help|--help|-h)
            show_usage
            exit 0
            ;;
        *)
            echo "エラー: 不明なコマンド: $1" >&2
            show_usage
            exit 1
            ;;
    esac
}

# スクリプトが直接実行された場合のみmain関数を呼び出し
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
