    - VIBEBOX_DEVCONTAINER_IMAGE  init時に生成するdevcontainer image
    - VIBEBOX_ENVCHAIN_SERVICE    init時に生成するenvchainサービス名
    - VIBEBOX_CONTAINER_USERNAME  init時に生成するコンテナユーザー名
EOF
}

# ビルドコマンド
build_image() {
    local tag="$1"
    local use_aws_env="$2"
    local no_cache="$3"
    shift 3
    local custom_build_args=("$@")

    echo "=== vibebox Dockerイメージをビルド中 ==="
    echo "イメージ名: ${IMAGE_NAME}:${tag}"
    echo "ビルドコンテキスト: $BUILD_CONTEXT"
    echo "Dockerfile: $DOCKERFILE_PATH"
    echo

    # Dockerfileの存在確認
    if [[ ! -f "$DOCKERFILE_PATH" ]]; then
        echo "エラー: Dockerfileが見つかりません: $DOCKERFILE_PATH" >&2
        exit 1
    fi

    # ビルド引数を構築
    local build_args=()

    # 任意のデフォルトビルド引数を追加
    local default_s3_bucket="${VIBEBOX_S3_DEV_BUCKET_NAME:-}"
    if [[ -n "$default_s3_bucket" ]]; then
        build_args+=(--build-arg "VIBEBOX_S3_DEV_BUCKET_NAME=${default_s3_bucket}")
    fi

    # カスタムビルド引数を追加
    build_args+=("${custom_build_args[@]}")

    # Docker buildコマンドを実行
    echo "Docker buildコマンドを実行中..."
    if [[ ${#build_args[@]} -gt 0 ]]; then
        echo "ビルド引数:"
        for arg in "${build_args[@]}"; do
            if [[ "$arg" == "--build-arg" ]]; then
                continue
            fi
            # センシティブな情報をマスク
            if [[ "$arg" =~ AWS_ACCESS_KEY_ID=.* ]] || [[ "$arg" =~ AWS_SECRET_ACCESS_KEY=.* ]] || [[ "$arg" =~ AWS_SESSION_TOKEN=.* ]]; then
                echo "  ${arg%%=*}=***"
            else
                echo "  $arg"
            fi
        done
        echo
    fi

    # --no-cacheオプションの処理
    local cache_option=()
    if [[ "$no_cache" == "true" ]]; then
        cache_option=(--no-cache)
        echo "注意: キャッシュを使用せずにビルドします"
        echo
    fi

    docker_cmd build \
        --secret id=aws_access_key_id,env=AWS_ACCESS_KEY_ID \
        --secret id=aws_secret_access_key,env=AWS_SECRET_ACCESS_KEY \
        --file "$DOCKERFILE_PATH" \
        --tag "${IMAGE_NAME}:${tag}" \
        --progress=plain \
        "${cache_option[@]}" \
        "${build_args[@]}" \
        "$BUILD_CONTEXT"

    echo
    echo "=== ビルド完了 ==="
    echo "イメージ: ${IMAGE_NAME}:${tag}"
    echo
    local docker_prefix
    docker_prefix=$(docker_cmd_prefix)
    echo "次のコマンドでコンテナを起動できます:"
    echo "  ${docker_prefix} run -it --rm ${IMAGE_NAME}:${tag} bash"
}

# ECRタグ付与処理
tag_image_core() {
    local tag="$1"
    local quiet="${2:-false}"

    local ecr_registry
    ecr_registry=$(resolve_vibebox_ecr_registry)
    if [[ -z "$ecr_registry" ]]; then
        echo "エラー: VIBEBOX_ECR_REGISTRY が設定されていません" >&2
        echo "例: export VIBEBOX_ECR_REGISTRY=123456789012.dkr.ecr.ap-northeast-1.amazonaws.com" >&2
        return 1
    fi
    local ecr_repository="${IMAGE_NAME}"
    local ecr_image="${ecr_registry}/${ecr_repository}:${tag}"

    if [[ "$quiet" != "true" ]]; then
        echo "=== vibebox DockerイメージにECRタグを付与 ==="
        echo "ローカルイメージ: ${IMAGE_NAME}:${tag}"
        echo "ECRイメージ: ${ecr_image}"
        echo
    fi

    if ! docker_cmd image inspect "${IMAGE_NAME}:${tag}" >/dev/null 2>&1; then
        echo "エラー: Dockerイメージが見つかりません: ${IMAGE_NAME}:${tag}" >&2
        echo "まず 'container build' コマンドでイメージをビルドしてください。" >&2
        return 1
    fi

    if [[ "$quiet" != "true" ]]; then
        echo "イメージにECRタグを付けています..."
    fi

    if ! docker_cmd tag "${IMAGE_NAME}:${tag}" "${ecr_image}"; then
        echo "エラー: イメージのタグ付けに失敗しました" >&2
        return 1
    fi

    if [[ "$quiet" != "true" ]]; then
        echo "✓ タグ付け完了: ${ecr_image}"
        echo
        echo "タグ付けされたイメージをプッシュするには:"
        echo "  docker push ${ecr_image}"
    else
        printf "%s" "$ecr_image"
    fi
}

tag_image() {
    local tag="$1"
    tag_image_core "$tag"
}

# container tagコマンド
container_tag_command() {
    local custom_tag=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --tag)
                custom_tag="$2"
                shift 2
                ;;
            --help|-h)
                show_usage
                exit 0
                ;;
            *)
                echo "エラー: 不明なオプション: $1" >&2
                show_usage
                exit 1
                ;;
        esac
    done

    if [[ -n "$custom_tag" ]]; then
        TAG="$custom_tag"
    fi

    tag_image "$TAG"
}

# pushコマンド
push_image() {
    local tag="$1"
    local ecr_registry
    ecr_registry=$(resolve_vibebox_ecr_registry)
    if [[ -z "$ecr_registry" ]]; then
        echo "エラー: VIBEBOX_ECR_REGISTRY が設定されていません" >&2
        echo "例: export VIBEBOX_ECR_REGISTRY=123456789012.dkr.ecr.ap-northeast-1.amazonaws.com" >&2
        exit 1
    fi

    local aws_region
    aws_region=$(resolve_vibebox_aws_region)
    if [[ -z "$aws_region" ]]; then
        echo "エラー: AWSリージョンが設定されていません" >&2
        echo "VIBEBOX_AWS_REGION または AWS_REGION を設定してください" >&2
        exit 1
    fi

    local ecr_repository="${IMAGE_NAME}"

    echo "=== vibebox DockerイメージをECRにプッシュ ==="
    echo "ローカルイメージ: ${IMAGE_NAME}:${tag}"
    echo "ECRイメージ: ${ecr_registry}/${ecr_repository}:${tag}"
    echo

    # ECRにログイン
    echo "ECRにログイン中..."
    if ! aws ecr get-login-password --region "$aws_region" | docker_cmd login --username AWS --password-stdin "${ecr_registry}" 2>/dev/null; then
        echo "エラー: ECRへのログインに失敗しました" >&2
        echo "AWS認証情報が正しく設定されているか確認してください。" >&2
        exit 1
    fi
    echo "✓ ECRにログインしました"
    echo

    echo "イメージにECRタグを付けています..."
    local tagged_ecr_image
    if ! tagged_ecr_image=$(tag_image_core "$tag" "true"); then
        exit 1
    fi
    echo "✓ タグ付け完了: ${tagged_ecr_image}"
    echo

    # ECRにプッシュ
    echo "イメージをECRにプッシュ中..."
    if ! docker_cmd push "${tagged_ecr_image}"; then
        echo "エラー: イメージのプッシュに失敗しました" >&2
        exit 1
    fi

    echo
    echo "=== プッシュ完了 ==="
    echo "ECRイメージ: ${tagged_ecr_image}"
    echo
    echo "プッシュされたイメージを使用するには:"
    echo "  docker pull ${tagged_ecr_image}"
}

# ワークスペース削除ヘルパー
remove_workspace_directory() {
    local branch_name="$1"

    if [[ -z "$branch_name" ]]; then
        echo "エラー: ワークスペース削除のブランチ名が指定されていません" >&2
        return 1
    fi

    local workspace_path="$PROJECT_ROOT/.vibebox-workspaces/$branch_name"

    if [[ ! -d "$workspace_path" ]]; then
        echo "ワークスペースは存在しません: $workspace_path"
        return 0
    fi

    echo "ワークスペースを削除します: $workspace_path"
    if rm -rf "$workspace_path"; then
        echo "✓ ワークスペースを削除しました"
        rmdir -p "$(dirname "$workspace_path")" 2>/dev/null || true

        local vibebox_dir="$PROJECT_ROOT/.vibebox-workspaces"
        if [[ -d "$vibebox_dir" ]] && [[ -z "$(ls -A "$vibebox_dir" 2>/dev/null)" ]]; then
            rmdir "$vibebox_dir" 2>/dev/null || true
        fi
    else
        echo "✗ ワークスペースの削除に失敗しました" >&2
        return 1
    fi

    return 0
}

remove_all_workspaces() {
    local vibebox_dir="$PROJECT_ROOT/.vibebox-workspaces"

    if [[ ! -d "$vibebox_dir" ]]; then
        echo "削除対象のワークスペースはありません: $vibebox_dir"
        return 0
    fi

    shopt -s nullglob
    local workspace_paths=("$vibebox_dir"/*)
    shopt -u nullglob

    if [[ ${#workspace_paths[@]} -eq 0 ]]; then
        echo "削除対象のワークスペースはありません。"
        return 0
    fi

    for workspace_path in "${workspace_paths[@]}"; do
        if [[ -d "$workspace_path" ]]; then
            local branch_name="${workspace_path#$vibebox_dir/}"
            remove_workspace_directory "$branch_name"
        fi
    done

    return 0
}

# stopコマンド（--all用）
stop_all_sessions() {
    local remove_workspace_flag="${1:-false}"

    echo "=== すべての devcontainer セッションを停止 ==="
    echo

    # gitリポジトリ名を取得
    local git_repo_name
    git_repo_name=$(basename "$PROJECT_ROOT")

    # 稼働中のdevcontainerコンテナを取得
    local container_ids
    container_ids=$(docker_cmd ps --filter "name=vibebox.${git_repo_name}" --format "{{.ID}}" 2>/dev/null)

    if [[ -z "$container_ids" ]]; then
        echo "現在稼働中のdevcontainerセッションはありません。"
    else
        echo "すべてのdevcontainerセッションを停止します..."
        echo

        local count=0
        local stopped_branch_names=()

        while IFS= read -r container_id; do
            if [[ -n "$container_id" ]]; then
                count=$((count + 1))
                # コンテナ名を取得
                local container_name
                container_name=$(docker_cmd inspect "$container_id" --format '{{.Name}}' 2>/dev/null | sed 's/^\/*//')
                echo "セッション $container_name を停止中..."

                # ワークスペースパスを特定してdevcontainer downを試行
                if [[ "$container_name" =~ devcontainer\.${git_repo_name}\.(.+)$ ]]; then
                    local branch_name="${BASH_REMATCH[1]}"
                    # ハイフンをスラッシュに戻す
                    branch_name="${branch_name//-/\/}"
                    stopped_branch_names+=("$branch_name")
                    local workspace_path="$PROJECT_ROOT/.vibebox-workspaces/$branch_name"

                    if command -v devcontainer &> /dev/null && [[ -d "$workspace_path" ]]; then
                if devcontainer_cmd down --workspace-folder "$workspace_path" >/dev/null 2>&1; then
                            echo "  ✓ 停止完了 (devcontainer down)"
                        else
                            # devcontainer downが失敗した場合は直接停止
                            docker_cmd stop "$container_id" >/dev/null 2>&1
                            if [[ $? -eq 0 ]]; then
                                docker_cmd rm "$container_id" >/dev/null 2>&1
                                if [[ $? -eq 0 ]]; then
                                    echo "  ✓ 停止・削除完了 (docker stop & rm)"
                                else
                                    echo "  ✓ 停止完了、削除失敗 (docker stop)"
                                fi
                            else
                                echo "  ✗ 停止失敗"
                            fi
                        fi
                else
                        # devcontainer CLIがない場合は直接停止
                        docker_cmd stop "$container_id" >/dev/null 2>&1
                        if [[ $? -eq 0 ]]; then
                            docker_cmd rm "$container_id" >/dev/null 2>&1
                            if [[ $? -eq 0 ]]; then
                                echo "  ✓ 停止・削除完了"
                            else
                                echo "  ✓ 停止完了、削除失敗"
                            fi
                        else
                            echo "  ✗ 停止失敗"
                        fi
                    fi
                else
                    # 名前パターンが一致しない場合も停止を試行
                    docker_cmd stop "$container_id" >/dev/null 2>&1
                    if [[ $? -eq 0 ]]; then
                        docker_cmd rm "$container_id" >/dev/null 2>&1
                        if [[ $? -eq 0 ]]; then
                            echo "  ✓ 停止・削除完了"
                        else
                            echo "  ✓ 停止完了、削除失敗"
                        fi
                    else
                        echo "  ✗ 停止失敗"
                    fi
                fi
            fi
        done <<< "$container_ids"

        if [[ $count -eq 0 ]]; then
            echo "停止対象のセッションがありませんでした。"
        else
            echo
            echo "$count 個のセッションを停止しました。"
        fi

        if [[ "$remove_workspace_flag" == "true" ]]; then
            echo
            echo "ワークスペース削除オプションが指定されています。"
            if [[ ${#stopped_branch_names[@]} -gt 0 ]]; then
                for branch_name in "${stopped_branch_names[@]}"; do
                    remove_workspace_directory "$branch_name" || true
                done
            fi
        fi
    fi

    # tmuxセッションをチェックして削除
    if command -v tmux &> /dev/null; then
        local tmux_session="vibebox_${git_repo_name//[.\/-]/_}"

        if tmux has-session -t "$tmux_session" 2>/dev/null; then
            echo
            echo "tmuxセッションを削除します: $tmux_session"
            tmux kill-session -t "$tmux_session" 2>/dev/null
            if [[ $? -eq 0 ]]; then
                echo "✓ tmuxセッションを削除しました。"
            else
                echo "✗ tmuxセッションの削除に失敗しました。"
            fi
        fi
    fi
    if [[ "$remove_workspace_flag" == "true" ]]; then
        echo
        echo "残りのワークスペースをクリーンアップしています..."
        remove_all_workspaces
    fi
}

# stopコマンド（ブランチ名ベース）
stop_session() {
    local branch_name="$1"
    local remove_workspace_flag="${2:-false}"

    # ブランチ名が省略された場合、カレントディレクトリから自動取得を試行
    if [[ -z "$branch_name" ]]; then
        branch_name=$(get_current_branch_name)
        if [[ -z "$branch_name" ]]; then
            echo "エラー: ブランチ名が指定されておらず、カレントディレクトリからも自動取得できませんでした" >&2
            echo "ワークスペースディレクトリ内で実行するか、ブランチ名を明示的に指定してください" >&2
            exit 1
        fi
        echo "カレントディレクトリから自動取得したブランチ名: $branch_name"
    fi

    echo "=== vibebox セッション停止 ==="
    echo "ブランチ: $branch_name"
    echo

    # gitリポジトリかどうかチェック
    if [[ ! -d "$PROJECT_ROOT/.git" ]]; then
        echo "エラー: プロジェクトルートがgitリポジトリではありません" >&2
        exit 1
    fi

    # ワークスペースパスを構築
    local workspace_path="$PROJECT_ROOT/.vibebox-workspaces/$branch_name"

    # tmuxセッション名とウィンドウ名を構築
    local git_repo_name
    git_repo_name=$(basename "$PROJECT_ROOT")
    local tmux_session="${git_repo_name//[.\/-]/_}/vibebox"
    local tmux_window="${branch_name//[\/.-]/_}"

    # サニタイズされたブランチ名（スラッシュをハイフンに置換）
    local sanitized_branch="${branch_name//\//-}"
    local expected_container_name="vibebox.${git_repo_name}.${sanitized_branch}"

    # コンテナIDを検索
    local container_id=""
    container_id="$(docker_find_running_container_id_by_name "$expected_container_name" || true)"

    # セッションが見つからない場合
    if [[ -z "$container_id" ]]; then
        echo "エラー: ブランチ '$branch_name' のvibeboxコンテナが起動していません。" >&2
        echo
        echo "稼働中のセッション一覧:"
        list_sessions
        exit 1
    fi

    echo "コンテナ名: $expected_container_name"
    echo "コンテナID: $container_id"

    # devcontainer CLIには停止インターフェースが無いため、直接Dockerで停止
    echo "Dockerコンテナを停止中..."
    docker_cmd stop "$container_id" >/dev/null 2>&1
    if [[ $? -eq 0 ]]; then
        echo "✓ コンテナを停止しました。"

        # コンテナを削除
        echo "Dockerコンテナを削除中..."
        docker_cmd rm "$container_id" >/dev/null 2>&1
        if [[ $? -eq 0 ]]; then
            echo "✓ コンテナを削除しました。"
        else
            echo "✗ コンテナの削除に失敗しました。"
        fi
    else
        echo "✗ コンテナの停止に失敗しました。"
        exit 1
    fi

    # tmuxウィンドウを確認して閉じる
    if command -v tmux &> /dev/null && tmux has-session -t "$tmux_session" 2>/dev/null; then
        if tmux list-windows -t "$tmux_session" -F "#{window_name}" | grep -q "^${tmux_window}$"; then
            echo "tmuxウィンドウを閉じます: $tmux_session:$tmux_window"
            tmux kill-window -t "$tmux_session:$tmux_window" 2>/dev/null || true
        fi
    fi

    if [[ "$remove_workspace_flag" == "true" ]]; then
        echo
        echo "--rm が指定されたため、ワークスペースを削除します..."
        if ! remove_workspace_directory "$branch_name"; then
            echo "⚠️  ワークスペースの削除に失敗しました" >&2
            exit 1
        fi
    fi
}

# attachコマンド（ブランチ名ベース）
attach_default_devcontainer() {
    if [[ ! -d "$PROJECT_ROOT/.git" ]]; then
        echo "エラー: プロジェクトルートがgitリポジトリではありません" >&2
        exit 1
    fi

    local git_repo_name
    git_repo_name=$(basename "$PROJECT_ROOT")

    local expected_container_name="vibebox.${git_repo_name}"
    local container_id

    container_id="$(docker_find_running_container_id_by_name "$expected_container_name" || true)"

    if [[ -z "$container_id" ]]; then
        echo "エラー: デフォルトdevcontainerが起動していません: $expected_container_name" >&2
        echo "'docker ps | grep $expected_container_name' で確認してください。" >&2
        exit 1
    fi

    echo "コンテナ名: $expected_container_name"
    echo "コンテナID: $container_id"

    local workspace_folder
    workspace_folder=$(get_devcontainer_workspace_folder)

    local actual_workspace_folder
    if [[ "$workspace_folder" == '\$HOME' ]] || docker_cmd exec "$container_id" test -d "$workspace_folder" 2>/dev/null; then
        actual_workspace_folder="$workspace_folder"
    else
        echo "警告: ワークスペースフォルダ '$workspace_folder' が存在しません。ホームディレクトリを使用します。"
        actual_workspace_folder='\$HOME'
    fi

    if [[ "$actual_workspace_folder" == '\$HOME' ]]; then
        docker_cmd exec -e TERM=xterm-256color -e COLORTERM=truecolor -it "$container_id" bash -c 'cd $HOME && exec $SHELL'
    else
        docker_cmd exec -e TERM=xterm-256color -e COLORTERM=truecolor -it "$container_id" bash -c "cd $actual_workspace_folder && exec \$SHELL"
    fi
}

# attachコマンド（ブランチ名ベース）
attach_session() {
    local branch_name="$1"

    # ブランチ名が省略された場合、カレントディレクトリから自動取得を試行
    if [[ -z "$branch_name" ]]; then
        branch_name=$(get_current_branch_name || true)
        if [[ -n "$branch_name" ]]; then
            echo "カレントディレクトリから自動取得したブランチ名: $branch_name"
        else
            # ワークスペース外での無引数実行時はデフォルトdevcontainerに直接アタッチ
            attach_default_devcontainer
            return
        fi
    fi

    echo "=== vivebox セッションにアタッチ ==="
    echo "ブランチ: $branch_name"

    # gitリポジトリかどうかチェック
    if [[ ! -d "$PROJECT_ROOT/.git" ]]; then
        echo "エラー: プロジェクトルートがgitリポジトリではありません" >&2
        exit 1
    fi

    # tmuxセッション名を構築
    local git_repo_name
    git_repo_name=$(basename "$PROJECT_ROOT")
    local tmux_session="${git_repo_name//[.\/-]/_}/vibebox"

    # tmuxがインストールされているかチェック
    if ! command -v tmux &> /dev/null; then
        echo "エラー: tmuxがインストールされていません。" >&2
        echo "tmuxをインストールしてから再度実行してください。" >&2
        exit 1
    fi

    # tmuxセッションが存在するかチェック
    if ! tmux has-session -t "$tmux_session" 2>/dev/null; then
        echo "エラー: tmuxセッション '$tmux_session' が存在しません。" >&2
        echo
        echo "セッションを開始するには:"
        echo "  $0 up $branch_name"
        exit 1
    fi

    # ブランチ名に対応するtmuxウィンドウ名を構築
    local tmux_window="${branch_name//[\/.-]/_}"

    # ウィンドウが存在するかチェック
    if ! tmux list-windows -t "$tmux_session" -F "#{window_name}" | grep -q "^${tmux_window}$"; then
        echo "エラー: ブランチ '$branch_name' のセッションが起動していません。" >&2
        echo
        echo "セッションを開始するには:"
        echo "  $0 up $branch_name"
        exit 1
    fi

    echo "tmuxセッション: $tmux_session"
    echo "tmuxウィンドウ: $tmux_window"
    echo "アタッチします..."
    echo

    # 特定のウィンドウにアタッチ
    if [[ -n "$TMUX" ]]; then
        # 既にtmux内にいる場合は、ウィンドウを切り替える
        tmux switch-client -t "$tmux_session:$tmux_window"
    else
        # tmux外からの場合は、セッションにアタッチ
        tmux attach-session -t "$tmux_session:$tmux_window"
    fi
}

# list-workspaceコマンド
list_workspaces() {
    echo "=== .vibebox-workspaces ワークスペース一覧 ==="
    echo

    # gitリポジトリかどうかチェック
    if [[ ! -d "$PROJECT_ROOT/.git" ]]; then
        echo "エラー: プロジェクトルートがgitリポジトリではありません" >&2
        exit 1
    fi

    local vibebox_dir="$PROJECT_ROOT/.vibebox-workspaces"

    # vibebox-workspacesディレクトリが存在するかチェック
    if [[ ! -d "$vibebox_dir" ]]; then
        echo "ワークスペースディレクトリが存在しません: $vibebox_dir"
        echo
        echo "ワークスペースを作成するには:"
        echo "  $0 up [branch-name]"
        return 0
    fi

    echo "ワークスペースディレクトリ: $vibebox_dir"
    echo

    # ワークスペース一覧を取得
    local workspace_count=0
    local workspaces=()

    for workspace_path in "$vibebox_dir"/*; do
        if [[ -d "$workspace_path" ]]; then
            local branch_name
            branch_name=$(basename "$workspace_path")
            workspaces+=("$branch_name")
            workspace_count=$((workspace_count + 1))
        fi
    done

    if [[ $workspace_count -eq 0 ]]; then
        echo "ワークスペースが見つかりませんでした。"
        echo
        echo "ワークスペースを作成するには:"
        echo "  $0 up [branch-name]"
        return 0
    fi

    echo "総ワークスペース数: $workspace_count"
    echo
    echo "ワークスペース一覧:"
    echo "────────────────────────────────────────────────────────────"

    # gitリポジトリ名を取得（コンテナ状態チェック用）
    local git_repo_name
    git_repo_name=$(basename "$PROJECT_ROOT")

    # ワークスペースを一覧表示
    for branch_name in "${workspaces[@]}"; do
        local workspace_path="$vibebox_dir/$branch_name"
        echo "📁 $branch_name"
        echo "   パス: $workspace_path"

        # Gitブランチ情報を取得
        if git -C "$workspace_path" status >/dev/null 2>&1; then
            local current_branch
            current_branch=$(git -C "$workspace_path" rev-parse --abbrev-ref HEAD 2>/dev/null)
            if [[ -n "$current_branch" ]]; then
                echo "   ブランチ: $current_branch"
            fi

            # 最後のコミット情報
            local last_commit
            last_commit=$(git -C "$workspace_path" log -1 --format="%h %s (%cr)" 2>/dev/null)
            if [[ -n "$last_commit" ]]; then
                echo "   最新コミット: $last_commit"
            fi

            # 未コミットの変更があるかチェック
            if ! git -C "$workspace_path" diff --quiet 2>/dev/null || ! git -C "$workspace_path" diff --cached --quiet 2>/dev/null; then
                echo "   ⚠️  未コミットの変更あり"
            fi
        else
            echo "   ⚠️  Gitリポジトリではありません"
        fi

        # 対応するコンテナが稼働中かチェック
        local sanitized_branch="${branch_name//\//-}"
        local expected_container_name="vibebox.${git_repo_name}.${sanitized_branch}"
        local container_id
        container_id="$(docker_find_running_container_id_by_name "$expected_container_name" || true)"

        if [[ -n "$container_id" ]]; then
            echo "   🟢 コンテナ稼働中 ($container_id)"
        else
            echo "   ⚪ コンテナ停止中"
        fi

        # ワークスペースサイズ
        local size
        if command -v du &> /dev/null; then
            size=$(du -sh "$workspace_path" 2>/dev/null | cut -f1)
            if [[ -n "$size" ]]; then
                echo "   サイズ: $size"
            fi
        fi

        echo
    done

    echo "════════════════════════════════════════════════════════════"
    echo
    echo "コマンド:"
    echo "  セッション開始: $0 up [branch-name]"
    echo "  エディタで開く: $0 edit <branch-name>"
    echo "  シェル起動: $0 shell <branch-name>"
    echo "  セッション停止: $0 down <branch-name>"
    echo "  ワークスペース一覧: $0 list"
}

# list-sessionコマンド
list_sessions() {
    echo "=== 稼働中の vibebox コンテナセッション一覧 ==="
    echo

    # gitリポジトリ名を取得
    local git_repo_name
    git_repo_name=$(basename "$PROJECT_ROOT")

    # vibeboxコンテナを検索（リポジトリ名を含むコンテナ）
    local containers
    containers=$(docker_cmd ps --filter "name=vibebox.${git_repo_name}" --format "table {{.ID}}\t{{.Names}}\t{{.Status}}\t{{.CreatedAt}}\t{{.Image}}" 2>/dev/null)

    if [[ -z "$containers" ]] || [[ "$containers" == "CONTAINER ID"* && $(echo "$containers" | wc -l) -eq 1 ]]; then
        echo "現在稼働中のvibeboxセッションはありません。"
        echo
        echo "新しいセッションを開始するには:"
        echo "  $0 up [branch-name]"
        return 0
    fi

    echo "$containers"
    echo

    # 各コンテナの詳細情報を表示
    echo "=== セッション詳細 ==="
    local container_ids
    container_ids=$(docker_cmd ps --filter "name=vibebox.${git_repo_name}" --format "{{.ID}}" 2>/dev/null)

    local count=0
    while IFS= read -r container_id; do
        if [[ -n "$container_id" ]]; then
            count=$((count + 1))
            echo
            echo "セッション #$count"
            echo "----------------------------------------"

            # コンテナ名を取得
            local container_name
            container_name=$(docker_cmd inspect "$container_id" --format '{{.Name}}' 2>/dev/null | sed 's/^\/*//')
            echo "  コンテナ名: $container_name"
            echo "  コンテナID: $container_id"

            # コンテナ名からブランチ名を抽出
            # パターン: vibebox.{repo-name}.{branch-name}
            if [[ "$container_name" =~ vibebox\.${git_repo_name}\.(.+)$ ]]; then
                local branch_name="${BASH_REMATCH[1]}"
                # ハイフンをスラッシュに戻す（サニタイズの逆）
                branch_name="${branch_name//-/\/}"
                echo "  ブランチ: $branch_name"

                # ワークスペースパスを表示
                local workspace_path="$PROJECT_ROOT/.vibebox-workspaces/$branch_name"
                if [[ -d "$workspace_path" ]]; then
                    echo "  Workspace: $workspace_path"
                fi
            fi

            # 作成時間を取得
            local created_at
            created_at=$(docker_cmd inspect "$container_id" --format '{{.Created}}' 2>/dev/null | sed 's/T/ /' | sed 's/\..*//')
            if [[ -n "$created_at" ]]; then
                echo "  開始時間: $created_at"
            fi

            # イメージタグを取得
            local image_tag
            image_tag=$(docker_cmd inspect "$container_id" --format '{{.Config.Image}}' 2>/dev/null)
            if [[ -n "$image_tag" ]]; then
                echo "  イメージ: $image_tag"
            fi

            # tmuxセッション/ウィンドウの状態を確認
            local tmux_session="vibebox_${git_repo_name//[.\/-]/_}"

            if [[ "$container_name" =~ vibebox\.${git_repo_name}\.(.+)$ ]]; then
                local sanitized_branch="${BASH_REMATCH[1]}"
                # ハイフンをアンダースコアに変換（tmuxウィンドウ名用）
                local tmux_window="${sanitized_branch//-/_}"

                if command -v tmux &> /dev/null && tmux has-session -t "$tmux_session" 2>/dev/null; then
                    if tmux list-windows -t "$tmux_session" -F "#{window_name}" | grep -q "^${tmux_window}$"; then
                        echo "  tmuxセッション: アクティブ ($tmux_session:$tmux_window)"
                    else
                        echo "  tmuxセッション: 非アクティブ"
                    fi
                else
                    echo "  tmuxセッション: 非アクティブ"
                fi
            fi

            # 実行中のプロセスを確認
            local processes
            processes=$(docker_cmd exec "$container_id" ps aux 2>/dev/null | grep -E "(node|python|java)" | grep -v grep | head -3)
            if [[ -n "$processes" ]]; then
                echo "  実行中のプロセス:"
                echo "$processes" | while IFS= read -r line; do
                    # プロセス情報を簡潔に表示
                    local cmd=$(echo "$line" | awk '{for(i=11;i<=NF;i++) printf "%s ", $i; print ""}' | cut -c1-60)
                    echo "    $cmd"
                done
            fi
        fi
    done <<< "$container_ids"

    if [[ $count -eq 0 ]]; then
        echo "詳細情報を取得できませんでした。"
    else
        echo
        echo "セッションにアタッチするには:"
        echo "  $0 attach <branch-name>"
        echo
        echo "セッションを停止するには:"
        echo "  $0 down <branch-name>"
    fi
}

# start-sessionコマンド
start_session() {
    local branch_name="$1"
    local attach_flag="$2"

    echo "=== vibebox セッションを開始 ==="
    echo "ブランチ: $branch_name"
    echo

    # gitリポジトリかどうかチェック
    if [[ ! -d "$PROJECT_ROOT/.git" ]]; then
        echo "エラー: プロジェクトルートがgitリポジトリではありません" >&2
        exit 1
    fi

    # ワークスペースパスを構築
    local workspace_path="$PROJECT_ROOT/.vibebox-workspaces/$branch_name"
    echo "Workspace パス: $workspace_path"

    # ワークスペースが既に存在するかチェック
    if [[ -d "$workspace_path" ]]; then
        echo "既存のワークスペースを使用します: $workspace_path"

        # ワークスペースの状態確認
        if ! git -C "$workspace_path" status >/dev/null 2>&1; then
            echo "警告: ワークスペースが無効な状態です。削除して再作成します。"
            rm -rf "$workspace_path"
        else
            # 現在のブランチを確認
            local current_branch
            current_branch=$(git -C "$workspace_path" rev-parse --abbrev-ref HEAD 2>/dev/null)
            echo "現在のブランチ: $current_branch"

            # 指定されたブランチと異なる場合はチェックアウト
            if [[ "$current_branch" != "$branch_name" ]]; then
                echo "ブランチ '$branch_name' にチェックアウト中..."
                if ! git -C "$workspace_path" checkout "$branch_name" 2>/dev/null; then
                    echo "警告: ブランチのチェックアウトに失敗しました。fetch してから再試行します。"
                    git -C "$workspace_path" fetch origin
                    git -C "$workspace_path" checkout "$branch_name" || {
                        echo "エラー: ブランチ '$branch_name' にチェックアウトできませんでした" >&2
                        exit 1
                    }
                fi
            fi

            # 最新の変更を取得
            echo "最新の変更を取得中..."
            if ! git -C "$workspace_path" fetch origin; then
                echo "⚠ 警告: git fetchに失敗しましたが、処理を継続します"
            else
                if git -C "$workspace_path" show-ref --verify --quiet "refs/remotes/origin/$branch_name"; then
                    git -C "$workspace_path" merge "origin/$branch_name" --ff-only 2>/dev/null || {
                        echo "警告: fast-forward mergeができませんでした。手動でマージが必要かもしれません。"
                    }
                fi
            fi
        fi
    fi

    # ワークスペースが存在しない場合は作成
    if [[ ! -d "$workspace_path" ]]; then
        echo "Git cloneを実行中..."

        # ワークスペースディレクトリを作成
        mkdir -p "$(dirname "$workspace_path")"

        # リモートリポジトリのURLを取得
        local remote_url
        remote_url=$(git remote get-url origin 2>/dev/null)
        if [[ -z "$remote_url" ]]; then
            echo "エラー: originリモートが設定されていません" >&2
            exit 1
        fi

        echo "リモートURL: $remote_url"
        echo "クローン先: $workspace_path"

        # リポジトリをクローン
        if ! git clone "$remote_url" "$workspace_path"; then
            echo "エラー: リポジトリのクローンに失敗しました" >&2
            exit 1
        fi

        echo "クローンが完了しました: $workspace_path"

        # ブランチをチェックアウト
        cd "$workspace_path"

        # ブランチが存在するかチェック
        if git show-ref --verify --quiet "refs/heads/$branch_name"; then
            echo "既存ブランチ '$branch_name' にチェックアウトします"
            git checkout "$branch_name" || {
                echo "エラー: ブランチ '$branch_name' にチェックアウトできませんでした" >&2
                exit 1
            }
        elif git show-ref --verify --quiet "refs/remotes/origin/$branch_name"; then
            echo "リモートブランチ 'origin/$branch_name' をトラッキングするローカルブランチを作成します"
            git checkout -b "$branch_name" "origin/$branch_name" || {
                echo "エラー: ブランチ '$branch_name' の作成に失敗しました" >&2
                exit 1
            }
        else
            echo "新しいブランチ '$branch_name' を作成します"
            git checkout -b "$branch_name" || {
                echo "エラー: ブランチ '$branch_name' の作成に失敗しました" >&2
                exit 1
            }
        fi

        echo "ブランチ '$branch_name' にチェックアウト完了"
    fi

    # ワークスペースディレクトリの存在確認
    if [[ ! -d "$workspace_path" ]]; then
        echo "エラー: ワークスペースディレクトリが存在しません: $workspace_path" >&2
        exit 1
    fi

    # devcontainer.jsonを読み込んでvibebox.copyFilesに記載されているファイルをコピー
    cd "$workspace_path"

    echo "最新の変更を取得中..."
    if ! git pull origin main; then
        echo "⚠ 警告: git pull origin mainに失敗しましたが、処理を継続します"
    fi

    local devcontainer_json=".devcontainer/devcontainer.json"
    local devcontainer_local_json=".devcontainer/devcontainer.local.json"

    if [[ ! -f "$devcontainer_json" ]]; then
        echo "エラー: devcontainer.jsonが見つかりません: $devcontainer_json" >&2
        exit 1
    fi

    # jqがインストールされているかチェック
    if ! command -v jq &> /dev/null; then
        echo "エラー: jqがインストールされていません。jqをインストールしてください。" >&2
        exit 1
    fi

    # コメントと末尾のカンマを除去してクリーンなJSONを作成
    local cleaned_json=$(sed 's://.*$::g; s:/\*.*\*/::g' "$devcontainer_json")

    # vibebox.copyFilesが存在するかチェックして、ファイルをコピー
    local copy_files=$(echo "$cleaned_json" | jq -r '.vibebox.copyFiles // empty | .[]?' 2>/dev/null)

    echo "$(pwd)"
    if [[ -n "$copy_files" ]]; then
        echo "vibebox.copyFilesに記載されているファイルをコピー中..."
        echo "$copy_files" | while IFS= read -r file_path; do
            if [[ -n "$file_path" && "$file_path" != "null" ]]; then
                local source_file="$PROJECT_ROOT/$file_path"
                local dest_file="$workspace_path/$file_path"
                local dest_dir=$(dirname "$dest_file")

                if [[ -f "$source_file" ]]; then
                    echo "  $file_path をコピー中..."
                    # 必要に応じてディレクトリを作成
                    mkdir -p "$dest_dir"
                    cp "$source_file" "$dest_file"
                    echo "  ✓ $file_path のコピーが完了しました"
                else
                    echo "  ⚠ 警告: ファイルが見つかりません: $source_file"
                fi
            fi
        done
    else
        echo "vibebox.copyFilesが設定されていません。ファイルのコピーをスキップします。"
    fi

    echo

    echo "devcontainer.jsonを読み込んでdevcontainer.local.jsonを作成中..."

    # gitリポジトリ名を取得
    local git_repo_name
    git_repo_name=$(basename "$PROJECT_ROOT")

    # サニタイズされたブランチ名（スラッシュをハイフンに置換）
    local sanitized_branch="${branch_name//\//-}"

    # runArgsを更新（--name=vibebox.{repo_name}.{branch_name}の形式で設定）
    # 互換性のため --env-file 指定は自動で除去する
    echo "$cleaned_json" | jq --arg repo_name "$git_repo_name" --arg branch "$sanitized_branch" '
        def replace_initialize_hook($container_name):
            . as $root
            | ($root.remoteUser // "vibebox") as $remote_user
            | ("bash .devcontainer/hooks-initialize.sh " + $remote_user + " " + $container_name) as $hook
            |
            if ((.initializeCommand // null) | type) == "array"
               and (.initializeCommand | length) >= 3
               and .initializeCommand[0] == "bash"
               and .initializeCommand[1] == "-c" then
                if (.initializeCommand[2] | contains("hooks-initialize.sh")) then
                    .initializeCommand[2] = (.initializeCommand[2] | sub("bash \\.devcontainer/hooks-initialize\\.sh [^&]+ && "; $hook + " && "))
                else
                    .initializeCommand[2] = ($hook + " && " + .initializeCommand[2])
                end
            elif ((.initializeCommand // null) | type) == "string" then
                if (.initializeCommand | contains("hooks-initialize.sh")) then
                    .initializeCommand = (.initializeCommand | sub("bash \\.devcontainer/hooks-initialize\\.sh [^&]+ && "; $hook + " && "))
                else
                    .initializeCommand = ($hook + " && " + .initializeCommand)
                end
            elif .initializeCommand == null then
                .initializeCommand = ["bash", "-c", $hook]
            elif ((.initializeCommand // null) | type) == "array" then
                .initializeCommand = ["bash", "-c", $hook + " && " + (.initializeCommand | join(" "))]
            else
                .initializeCommand = ["bash", "-c", $hook + " && " + (.initializeCommand | tostring)]
            end;

        def strip_env_file_args:
            reduce .[] as $arg (
                {skip_next: false, out: []};
                if .skip_next then
                    .skip_next = false
                elif ($arg | test("^--env-file(=|$)")) then
                    if $arg == "--env-file" then
                        .skip_next = true
                    else
                        .
                    end
                else
                    .out += [$arg]
                end
            ) | .out;

        .runArgs = ((.runArgs // []) | strip_env_file_args)
        |
        if (.runArgs | map(test("^--name=")) | any) then
                # --name=が既に存在する場合は置換
                .runArgs = (.runArgs | map(
                    if test("^--name=") then
                        "--name=vibebox." + $repo_name + "." + $branch
                    else
                        .
                    end
                ))
        else
                # --name=が存在しない場合は追加
                .runArgs = .runArgs + ["--name=vibebox." + $repo_name + "." + $branch]
        end
        |
        replace_initialize_hook("vibebox." + $repo_name + "." + $branch)
    ' > "$devcontainer_local_json"

    echo "devcontainer.local.jsonを作成しました"

    # 必要なファイルの準備
    echo "必要なファイルを準備中..."

    # devcontainer CLIがインストールされているかチェック
    if ! command -v devcontainer &> /dev/null; then
        echo "エラー: devcontainer CLIがインストールされていません。" >&2
        echo "以下のコマンドでインストールしてください:" >&2
        echo "  npm install -g @devcontainers/cli" >&2
        exit 1
    fi

    # 既存のコンテナをチェック
    local expected_container_name="vibebox.${git_repo_name}.${sanitized_branch}"

    echo "既存のvibeboxコンテナをチェック中..."
    local existing_container_id

    # まず、稼働中のvibeboxコンテナを「想定しているコンテナ名」で厳密に検索する
    # (ブランチ名だけで検索すると、別リポジトリの同名ブランチのコンテナを誤って再利用してしまう)
    existing_container_id="$(docker_find_running_container_id_by_name "$expected_container_name" || true)"
    if [[ -n "$existing_container_id" ]]; then
        echo "既存の稼働中のvibeboxコンテナが見つかりました: $expected_container_name ($existing_container_id)"
    fi

            # 名前でマッチしなかった場合、ワークスペースディレクトリがマウントされているものを探す（稼働中のみ）
    if [[ -z "$existing_container_id" ]]; then
        local all_running_vibebox_containers
        all_running_vibebox_containers=$(docker_cmd ps --filter "name=vibebox" --format "{{.ID}}" 2>/dev/null)

        if [[ -n "$all_running_vibebox_containers" ]]; then
            while IFS= read -r container_id; do
                if [[ -n "$container_id" ]]; then
                    # マウント情報を確認
                    local mount_info
                    mount_info=$(docker_cmd inspect "$container_id" --format '{{range .Mounts}}{{if eq .Source "'$workspace_path'"}}FOUND{{end}}{{end}}' 2>/dev/null)
                    if [[ "$mount_info" == "FOUND" ]]; then
                        existing_container_id="$container_id"
                        local container_name
                        container_name=$(docker_cmd inspect "$container_id" --format '{{.Name}}' 2>/dev/null | sed 's/^\/*//')
                        echo "既存の稼働中のvibeboxコンテナが見つかりました（マウントで検索）: $container_name ($container_id)"
                        break
                    fi
                fi
            done <<< "$all_running_vibebox_containers"
        fi
    fi

    if [[ -n "$existing_container_id" ]]; then
        # コンテナの状態を再確認
        local container_state
        container_state=$(docker_cmd inspect "$existing_container_id" --format '{{.State.Status}}' 2>/dev/null)
        if [[ "$container_state" == "running" ]]; then
            local container_name
            container_name=$(docker_cmd inspect "$existing_container_id" --format '{{.Name}}' 2>/dev/null | sed 's/^\/*//')
            echo "既存のvibeboxコンテナを使用します: $container_name ($existing_container_id)"
        else
            echo "既存のコンテナが稼働していません (状態: $container_state)。新しいコンテナを起動します。"
            existing_container_id=""
        fi
    fi

    if [[ -z "$existing_container_id" ]]; then
        # 停止中/エラー状態のvibeboxコンテナを削除
        echo "停止中のvibeboxコンテナをクリーンアップ中..."
        local stopped_containers
        stopped_containers=$(docker_cmd ps -a --filter "name=vibebox" --filter "status=exited" --format "{{.ID}}" 2>/dev/null)
        if [[ -n "$stopped_containers" ]]; then
            echo "$stopped_containers" | xargs envchain "$IMAGE_NAME" docker rm -f >/dev/null 2>&1 || true
            echo "✓ 停止中のvibeboxコンテナを削除しました"
        fi

        # devcontainerを起動
        echo "vibeboxコンテナを起動中..."
        echo "実行コマンド: $(devcontainer_cmd_prefix) up --override-config $devcontainer_local_json --workspace-folder ."
        echo "処理中... (時間がかかる場合があります)"
        echo

        # devcontainer upコマンドを実行
        # 出力をリアルタイムで表示しつつ、最後の行（JSONレスポンス）を保存
        local temp_file=$(mktemp)

        # devcontainer upを実行し、出力を一時ファイルとターミナルの両方に送る
        if devcontainer_cmd up --override-config "$devcontainer_local_json" --workspace-folder . | tee "$temp_file"; then
            echo
            echo "devcontainerが起動しました"

            # 最後のJSONレスポンス行を取得
            local devcontainer_result
            devcontainer_result=$(tail -1 "$temp_file")

            # JSONレスポンスからcontainerIdを取得
            existing_container_id=$(echo "$devcontainer_result" | jq -r '.containerId // empty' 2>/dev/null)

            if [[ -z "$existing_container_id" ]]; then
                echo "警告: JSONレスポンスからcontainerIdを取得できませんでした" >&2
                echo "最後の行: $devcontainer_result" >&2

                # フォールバック: 最新のdevcontainerを探す
                echo "フォールバック: 最新のdevcontainerを検索中..."
                existing_container_id=$(docker_cmd ps --filter "name=devcontainer" --format "{{.ID}}\t{{.CreatedAt}}" | sort -k2 -r | head -1 | cut -f1)

                if [[ -n "$existing_container_id" ]]; then
                    echo "最新のdevcontainerを使用します: $existing_container_id"
                else
                    echo "エラー: devcontainerが見つかりませんでした" >&2
                    rm -f "$temp_file"
                    exit 1
                fi
            fi
        else
            echo "エラー: devcontainerの起動に失敗しました" >&2
            rm -f "$temp_file"
            exit 1
        fi

        # 一時ファイルをクリーンアップ
        rm -f "$temp_file"
    fi

    echo "コンテナID: $existing_container_id"
    echo

    docker_cmd exec "$existing_container_id" sudo bash -c "echo $branch_name > /var/run/vibebox-current-workspace"

    # tmuxセッション名とウィンドウ名を設定
    local tmux_session="${git_repo_name//[.\/-]/_}/vibebox"
    local tmux_window="${branch_name//[\/.-]/_}"

    echo "tmuxセッション: $tmux_session"
    echo "tmuxウィンドウ: $tmux_window"
    echo

    # tmuxがインストールされているかチェック
    if ! command -v tmux &> /dev/null; then
        echo "警告: tmuxがインストールされていません。通常モードで起動します。"
        echo "シェルを起動します..."
        echo "終了するには 'exit' を実行してください。"
        echo

        # Cursorでワークスペースを開く
        if command -v cursor &> /dev/null; then
            echo "Cursorでワークスペースを開いています..."
            cursor "$workspace_path" &
        fi

        # devcontainerでシェルを起動
        docker_cmd exec -it "$existing_container_id" sh -c 'cd /workspace && exec $SHELL'
        return
    fi

    # tmuxセッションが存在するかチェック
    if ! tmux has-session -t "$tmux_session" 2>/dev/null; then
        echo "新しいtmuxセッションを作成します: $tmux_session"
        # セッションを作成して、最初のウィンドウをconsole（ローカルシェル）として起動
        tmux new-session -d -s "$tmux_session" -n "console" -c "$PROJECT_ROOT"
        # ブランチ用の新しいウィンドウを作成
        echo "ブランチ用のtmuxウィンドウを作成します: $tmux_window"
        tmux new-window -t "$tmux_session" -n "$tmux_window" -c "$workspace_path"
    else
        # セッションは存在するが、ウィンドウが存在するかチェック
        if tmux list-windows -t "$tmux_session" -F "#{window_name}" | grep -q "^${tmux_window}$"; then
            echo "既存のtmuxウィンドウが見つかりました: $tmux_session:$tmux_window"

            # --attachフラグが設定されている場合のみアタッチ
            if [[ "$attach_flag" == "true" ]]; then
                echo "既存のtmuxウィンドウにアタッチします..."
                # 既にtmux内にいる場合
                if [[ -n "$TMUX" ]]; then
                    tmux switch-client -t "$tmux_session:$tmux_window"
                else
                    tmux attach-session -t "$tmux_session:$tmux_window"
                fi
            else
                echo "既存のセッションが見つかりました。アタッチするには以下のコマンドを実行してください:"
                echo "  $0 attach $branch_name"
            fi
            return
        else
            echo "新しいtmuxウィンドウを作成します: $tmux_window"
            tmux new-window -t "$tmux_session" -n "$tmux_window" -c "$workspace_path"
        fi
    fi

    # workspaceFolderを取得
    local workspace_folder
    workspace_folder=$(get_devcontainer_workspace_folder)

    # workspaceFolderが存在するかdevcontainer内で確認
    local actual_workspace_folder
    if [[ "$workspace_folder" == '\$HOME' ]] || docker_cmd exec "$existing_container_id" test -d "$workspace_folder" 2>/dev/null; then
        actual_workspace_folder="$workspace_folder"
    else
        echo "警告: ワークスペースフォルダ '$workspace_folder' が存在しません。ホームディレクトリを使用します。"
        actual_workspace_folder='\$HOME'
    fi

    echo "actual_workspace_folder: $actual_workspace_folder"

    # devcontainerでシェルを起動するDockerコマンドを構築
    local docker_exec_cmd
    if [[ "$actual_workspace_folder" == '\$HOME' ]]; then
        docker_exec_cmd="$(docker_cmd_prefix) exec -e TERM=xterm-256color -e COLORTERM=truecolor -it \"$existing_container_id\" bash -c 'cd \$HOME && exec \$SHELL'"
    else
        docker_exec_cmd="$(docker_cmd_prefix) exec -e TERM=xterm-256color -e COLORTERM=truecolor -it \"$existing_container_id\" bash -c \"cd $actual_workspace_folder && exec \\\$SHELL\""
    fi

    # tmuxウィンドウでDockerコマンドを実行
    tmux send-keys -t "$tmux_session:$tmux_window" "$docker_exec_cmd" Enter

    # Cursorでワークスペースを開く
    if command -v cursor &> /dev/null; then
        echo "Cursorでワークスペースを開いています..."
        cursor "$workspace_path" &
    fi

    # --attachフラグが設定されている場合のみtmuxセッションにアタッチ
    if [[ "$attach_flag" == "true" ]]; then
        echo "tmuxセッションにアタッチしています..."
        if [[ -n "$TMUX" ]]; then
            # 既にtmux内にいる場合は、ウィンドウを切り替える
            tmux switch-client -t "$tmux_session:$tmux_window"
        else
            # tmux外からの場合は、セッションにアタッチ
            tmux attach-session -t "$tmux_session:$tmux_window"
        fi
    else
        echo "セッションが開始されました。アタッチするには以下のコマンドを実行してください:"
        echo "  $0 attach $branch_name"
    fi
}

# shellコマンド
shell_session() {
    local branch_name="$1"

    # ブランチ名が省略された場合、カレントディレクトリから自動取得を試行
    if [[ -z "$branch_name" ]]; then
        branch_name=$(get_current_branch_name)
        if [[ -z "$branch_name" ]]; then
            echo "エラー: ブランチ名が指定されておらず、カレントディレクトリからも自動取得できませんでした" >&2
            echo "ワークスペースディレクトリ内で実行するか、ブランチ名を明示的に指定してください" >&2
            exit 1
        fi
        echo "カレントディレクトリから自動取得したブランチ名: $branch_name"
    fi

    echo "=== vibebox のシェルを起動 ==="
    echo "ブランチ: $branch_name"
    echo

    # gitリポジトリかどうかチェック
    if [[ ! -d "$PROJECT_ROOT/.git" ]]; then
        echo "エラー: プロジェクトルートがgitリポジトリではありません" >&2
        exit 1
    fi

    # gitリポジトリ名を取得
    local git_repo_name
    git_repo_name=$(basename "$PROJECT_ROOT")

    # サニタイズされたブランチ名（スラッシュをハイフンに置換）
    local sanitized_branch="${branch_name//\//-}"
    local expected_container_name="vibebox.${git_repo_name}.${sanitized_branch}"

    # コンテナIDを検索
    local container_id=""
    container_id="$(docker_find_running_container_id_by_name "$expected_container_name" || true)"

    # コンテナが見つからない場合
    if [[ -z "$container_id" ]]; then
        echo "エラー: ブランチ '$branch_name' のvibeboxコンテナが起動していません。" >&2
        echo
        echo "セッションを開始するには:"
        echo "  $0 up $branch_name"
        exit 1
    fi

    echo "コンテナ名: $expected_container_name"
    echo "コンテナID: $container_id"
    echo "シェルを起動します..."
    echo "終了するには 'exit' を実行してください。"
    echo

    # workspaceFolderを取得
    local workspace_folder
    workspace_folder=$(get_devcontainer_workspace_folder)

    # workspaceFolderが存在するかvibeboxコンテナ内で確認
    local actual_workspace_folder
    if [[ "$workspace_folder" == '\$HOME' ]] || docker_cmd exec "$container_id" test -d "$workspace_folder" 2>/dev/null; then
        actual_workspace_folder="$workspace_folder"
    else
        echo "警告: ワークスペースフォルダ '$workspace_folder' が存在しません。ホームディレクトリを使用します。"
        actual_workspace_folder='\$HOME'
    fi

    # シェルを起動
    if [[ "$actual_workspace_folder" == '\$HOME' ]]; then
        docker_cmd exec -e TERM=xterm-256color -e COLORTERM=truecolor -it "$container_id" bash -c 'cd $HOME && exec $SHELL'
    else
        docker_cmd exec -e TERM=xterm-256color -e COLORTERM=truecolor -it "$container_id" bash -c "cd $actual_workspace_folder && exec \$SHELL"
    fi
}

# editコマンド
edit_session() {
    local branch_name="$1"

    # ブランチ名が省略された場合、カレントディレクトリから自動取得を試行
    if [[ -z "$branch_name" ]]; then
        branch_name=$(get_current_branch_name)
        if [[ -z "$branch_name" ]]; then
            echo "エラー: ブランチ名が指定されておらず、カレントディレクトリからも自動取得できませんでした" >&2
            echo "ワークスペースディレクトリ内で実行するか、ブランチ名を明示的に指定してください" >&2
            exit 1
        fi
        echo "カレントディレクトリから自動取得したブランチ名: $branch_name"
    fi

    echo "=== ブランチのワークスペースをCursorで開く ==="
    echo "ブランチ: $branch_name"
    echo

    # gitリポジトリかどうかチェック
    if [[ ! -d "$PROJECT_ROOT/.git" ]]; then
        echo "エラー: プロジェクトルートがgitリポジトリではありません" >&2
        exit 1
    fi

    # ワークスペースパスを構築
    local workspace_path="$PROJECT_ROOT/.vibebox-workspaces/$branch_name"

    # ワークスペースが存在するかチェック
    if [[ ! -d "$workspace_path" ]]; then
        echo "エラー: ブランチ '$branch_name' のワークスペースが存在しません: $workspace_path" >&2
        echo
        echo "ワークスペースを作成するには:"
        echo "  $0 up $branch_name"
        exit 1
    fi

    echo "Workspace パス: $workspace_path"

    # Cursorがインストールされているかチェック
    if ! command -v cursor &> /dev/null; then
        echo "エラー: Cursorがインストールされていません。" >&2
        echo "Cursorをインストールしてから再度実行してください。" >&2
        exit 1
    fi

    echo "Cursorでワークスペースを開きます..."
    echo

    # Cursorでワークスペースディレクトリを開く
    cursor "$workspace_path"

    echo "Cursorで '$branch_name' ブランチのワークスペースを開きました。"
}

cd_local_session() {
    local branch_name="$1"

    if [[ -z "$branch_name" ]]; then
        branch_name=$(get_current_branch_name)
        if [[ -z "$branch_name" ]]; then
            echo "エラー: ブランチ名が指定されておらず、カレントディレクトリからも自動取得できませんでした" >&2
            echo "ワークスペースディレクトリ内で実行するか、ブランチ名を明示的に指定してください" >&2
            exit 1
        fi
        echo "カレントディレクトリから自動取得したブランチ名: $branch_name"
    fi

    echo "=== ローカルワークスペースをtmuxで開く ==="
    echo "ブランチ: $branch_name"
    echo

    if [[ ! -d "$PROJECT_ROOT/.git" ]]; then
        echo "エラー: プロジェクトルートがgitリポジトリではありません" >&2
        exit 1
    fi

    local workspace_path="$PROJECT_ROOT/.vibebox-workspaces/$branch_name"
    if [[ ! -d "$workspace_path" ]]; then
        echo "エラー: ブランチ '$branch_name' のワークスペースが存在しません: $workspace_path" >&2
        echo "  ワークスペースを作成するには: $0 up $branch_name" >&2
        exit 1
    fi
    echo "Workspace パス: $workspace_path"
    echo

    if ! command -v tmux &> /dev/null; then
        echo "エラー: tmuxがインストールされていません。" >&2
        echo "tmuxをインストールしてから再度実行してください。" >&2
        exit 1
    fi

    local git_repo_name
    git_repo_name=$(basename "$PROJECT_ROOT")
    local tmux_session="${git_repo_name//[.\/-]/_}/vibebox"
    local tmux_window="${branch_name//[\/.-]/_}(local)"

    if ! tmux has-session -t "$tmux_session" 2>/dev/null; then
        echo "tmuxセッションを作成します: $tmux_session"
        tmux new-session -d -s "$tmux_session" -n "console" -c "$PROJECT_ROOT"
    fi

    if tmux list-windows -t "$tmux_session" -F "#{window_name}" | grep -Fxq "$tmux_window"; then
        echo "既存のtmuxウィンドウを使用します: $tmux_session:$tmux_window"
        tmux send-keys -t "$tmux_session:$tmux_window" "cd $workspace_path" Enter
    else
        echo "tmuxウィンドウを作成します: $tmux_session:$tmux_window"
        tmux new-window -t "$tmux_session" -n "$tmux_window" -c "$workspace_path"
    fi

    echo
    echo "tmuxセッションに移動します..."
    if [[ -n "$TMUX" ]]; then
        tmux switch-client -t "$tmux_session:$tmux_window"
    else
        tmux attach-session -t "$tmux_session:$tmux_window"
    fi
}

# secrets setコマンド
secrets_set() {
    echo "=== vibebox AWSシークレット設定 ==="
    echo

    if ! command -v envchain &> /dev/null; then
        echo "エラー: envchain が見つかりません。brew install envchain などでインストールしてください。" >&2
        exit 1
    fi

    local envchain_service="$IMAGE_NAME"

